// M1 Post Squeeze Release logic relies on Market Structure Shifts and is handled
// dynamically inside OnTick().


//+------------------------------------------------------------------+
//| H1 Fibonacci Extension Gate                                      |
//|                                                                  |
//| Uses the LAST H1 DOWN-LEG only (not the full visible range):     |
//|   swing_hi = the pullback bar high identified by ClassifyH1Mom   |
//|   swing_lo = lowest H1 low between bar 0 and the pullback bar    |
//|                                                                  |
//| Extension target is placed BEYOND swing_lo (downtrend) or        |
//| swing_hi (uptrend). Mapped by momentum strength:                 |
//|   WEAK 38.2% | MODERATE 50% | STRONG 61.8%                      |
//+------------------------------------------------------------------+


//+------------------------------------------------------------------+
//| 1-Minute Squeeze + Major Liquidity Synergy Detector              |
//|                                                                  |
//| Fires when the M1 BB is squeezed AND price exits toward a major  |
//| or EQ liquidity level within 4 ATR, flagging the highest-        |
//| probability scenario: squeeze energy aimed at a known major pool.|
//+------------------------------------------------------------------+
void CheckM1SqueezeLiquiditySynergy() {
    d_m1_squeeze_lq_syn = false;
    d_m1_sqz_lq_txt     = "";
    if(!d_sqz_m1) return;
    double last_close = iClose(_Symbol, _Period, 1);
    double scan_dist  = atr_m1[0] * 4.0;
    bool exited_down = (last_close < bb_dn_m1[0]);
    bool exited_up   = (last_close > bb_up_m1[0]);
    if(exited_down) {
        double price = SymbolInfoDouble(_Symbol, SYMBOL_BID);
        for(int i = 0; i < ArraySize(active_supports); i++) {
            double lq = active_supports[i].price;
            if(lq < price && (price - lq) <= scan_dist) {
                if(active_supports[i].type == "EQL" || active_supports[i].deep_sweep) {
                    d_m1_squeeze_lq_syn = true;
                    d_m1_sqz_lq_txt = StringFormat("M1 SQZ->Major Liq @ %.5f (%.1fx ATR)", lq, (price - lq) / atr_m1[0]);
                    break;
                }
            }
        }
    } else if(exited_up) {
        double price = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
        for(int i = 0; i < ArraySize(active_resistances); i++) {
            double lq = active_resistances[i].price;
            if(lq > price && (lq - price) <= scan_dist) {
                if(active_resistances[i].type == "EQH" || active_resistances[i].deep_sweep) {
                    d_m1_squeeze_lq_syn = true;
                    d_m1_sqz_lq_txt = StringFormat("M1 SQZ->Major Liq @ %.5f (%.1fx ATR)", lq, (lq - price) / atr_m1[0]);
                    break;
                }
            }
        }
    }
}

//+------------------------------------------------------------------+
//| RSI-Adaptive H1 Zone Percentage                                  |
//|                                                                  |
//| Returns the effective H1 zone percentage for the given direction.|
//| When RSI shows strong momentum toward the band, the zone is      |
//| tight (= H1_Extreme_Zone_Pct). When momentum is weak the zone   |
//| expands linearly up to H1_RSI_Max_Zone_Pct (hard-capped at 0.25)|
//| which equals the midpoint between the BB mean and the band edge. |
//|                                                                  |
//+------------------------------------------------------------------+
double GetDynamicH1ZonePct(bool isBuy) {
    if(!Use_RSI_Zone_Adapt) return H1_Extreme_Zone_Pct;

    // Enforce hard cap: max zone may never exceed midpoint between mean and band
    // (mean ≈ 50% of band range from lower, so midpoint to lower/upper = 25%)
    double max_pct = MathMin(H1_RSI_Max_Zone_Pct, 0.25);
    double min_pct = MathMin(H1_Extreme_Zone_Pct, max_pct); // base (tight) zone
    double rsi     = d_rsi_h1_value;
    double dynamic_pct;

    if(isBuy) {
        // Buy zone (near lower band).
        // Weak DOWN momentum = RSI is NOT very low (climbing toward 50).
        //   RSI <= RSI_Strong_Dn (e.g. 30) → strong sell pressure → tight zone
        //   RSI >= RSI_Weak_Level (e.g. 50) → sell pressure fading → widest zone
        if(rsi <= RSI_Strong_Dn)
            dynamic_pct = min_pct;
        else if(rsi >= RSI_Weak_Level)
            dynamic_pct = max_pct;
        else {
            // Linear interpolation between RSI_Strong_Dn and RSI_Weak_Level
            double ratio = (rsi - RSI_Strong_Dn) / (RSI_Weak_Level - RSI_Strong_Dn);
            dynamic_pct  = min_pct + ratio * (max_pct - min_pct);
        }
    } else {
        // Sell zone (near upper band).
        // Weak UP momentum = RSI is NOT very high (falling toward 50).
        //   RSI >= RSI_Strong_Up (e.g. 70) → strong buy pressure → tight zone
        //   RSI <= RSI_Weak_Level (e.g. 50) → buy pressure fading → widest zone
        if(rsi >= RSI_Strong_Up)
            dynamic_pct = min_pct;
        else if(rsi <= RSI_Weak_Level)
            dynamic_pct = max_pct;
        else {
            // Linear interpolation between RSI_Weak_Level and RSI_Strong_Up
            double ratio = (RSI_Strong_Up - rsi) / (RSI_Strong_Up - RSI_Weak_Level);
            dynamic_pct  = min_pct + ratio * (max_pct - min_pct);
        }
    }

    return dynamic_pct;
}

//+------------------------------------------------------------------+
//| Get Dynamic Mean Zone Pct based on ADX or RSI                    |
//+------------------------------------------------------------------+
double GetDynamicMeanZonePct(double adx_val, double rsi_val, int trend_dir, double base_pct) {
    if(!Use_Dynamic_Mean_Zone) return base_pct;
    
    if(Dyn_Mean_Mode == DYN_MEAN_ADX) {
        if(adx_val <= ADX_Threshold) return base_pct;
        if(adx_val >= 50.0) return MaxMeanZonePct;
        
        double ratio = (adx_val - ADX_Threshold) / (50.0 - ADX_Threshold);
        return base_pct + ratio * (MaxMeanZonePct - base_pct);
    } 
    else if(Dyn_Mean_Mode == DYN_MEAN_RSI) {
        if(trend_dir == 0) return base_pct;
        
        double ratio = 0.0;
        if(trend_dir == 1) { // Up Trend
            if(rsi_val <= 50.0) return base_pct;
            if(rsi_val >= RSI_Strong_Up) return MaxMeanZonePct;
            ratio = (rsi_val - 50.0) / (RSI_Strong_Up - 50.0);
        } else if(trend_dir == -1) { // Down Trend
            if(rsi_val >= 50.0) return base_pct;
            if(rsi_val <= RSI_Strong_Dn) return MaxMeanZonePct;
            ratio = (50.0 - rsi_val) / (50.0 - RSI_Strong_Dn);
        }
        return base_pct + ratio * (MaxMeanZonePct - base_pct);
    }
    
    return base_pct;
}

//+------------------------------------------------------------------+
//| Structural Clearance Logic                                       |
//+------------------------------------------------------------------+
bool CheckStructuralClearance(bool isBuy, double price) {
    if(!Use_Clearance_Filter) return true;
    int limit = 100; 
    if(isBuy) {
        double broken_sup = 0; int sup_idx = -1;
        for(int i=2; i<limit; i++) { if(IsBottomFractal(i)) { double f_low = iLow(_Symbol, _Period, i); if(f_low > price) { broken_sup = f_low; sup_idx = i; break; } } }
        if(sup_idx == -1) return true; 
        double prior_high = 0;
        for(int i=sup_idx+1; i<limit; i++) { if(IsTopFractal(i)) { prior_high = iHigh(_Symbol, _Period, i); break; } }
        if(prior_high <= broken_sup) return true; 
        double range_height = prior_high - broken_sup; double required_distance = range_height * Clearance_Multiplier;
        return ((broken_sup - price) >= required_distance);
    } 
    else {
        double broken_res = 0; int res_idx = -1;
        for(int i=2; i<limit; i++) { if(IsTopFractal(i)) { double f_high = iHigh(_Symbol, _Period, i); if(f_high < price) { broken_res = f_high; res_idx = i; break; } } }
        if(res_idx == -1) return true; 
        double prior_low = 0;
        for(int i=res_idx+1; i<limit; i++) { if(IsBottomFractal(i)) { prior_low = iLow(_Symbol, _Period, i); break; } }
        if(prior_low == 0 || prior_low >= broken_res) return true;
        double range_height = broken_res - prior_low; double required_distance = range_height * Clearance_Multiplier;
        return ((price - broken_res) >= required_distance);
    }
}

//+------------------------------------------------------------------+
//| Live Spike Detection Helper                                      |
//+------------------------------------------------------------------+
bool IsCurrentSpike(int lookback, double multiplier, int atr_shift) {
    double max_h = 0.0;
    double min_l = 999999.0;
    for(int k = 0; k < lookback; k++) {
        double h = iHigh(_Symbol, _Period, k);
        double l = iLow(_Symbol, _Period, k);
        if(h > max_h) max_h = h;
        if(l < min_l) min_l = l;
    }
    double setup_range = max_h - min_l;
    
    int safe_shift = atr_shift;
    if(safe_shift >= ArraySize(atr_m1)) safe_shift = ArraySize(atr_m1) - 1;
    
    if(atr_m1[safe_shift] > 0) return (setup_range >= (atr_m1[safe_shift] * multiplier));
    return false;
}

//+------------------------------------------------------------------+
//| MTF Zone Validation Helper                                       |
//+------------------------------------------------------------------+
bool ValidMTFZone(double price, double lower, double upper, bool isBuy, double allowed_pct) { 
    double range = upper - lower; 
    if(isBuy) return (price <= (lower + (range * allowed_pct))); 
    else return (price >= (upper - (range * allowed_pct))); 
}

//+------------------------------------------------------------------+
//| End of Day Filter                                                |
//+------------------------------------------------------------------+
bool IsEndOfDayRestricted() {
    if(!Use_EOD_Filter) return false;
    
    datetime current_time = TimeCurrent();
    MqlDateTime dt;
    TimeToStruct(current_time, dt);
    
    // Server time midnight check (23:59 -> 00:00)
    int current_minute_of_day = dt.hour * 60 + dt.min;
    
    int end_of_day_limit = 24 * 60 - EOD_Mins_Before;
    int start_of_day_limit = EOD_Mins_After;
    
    if (current_minute_of_day >= end_of_day_limit || current_minute_of_day < start_of_day_limit) {
        return true;
    }
    
    return false;
}

//+------------------------------------------------------------------+
//| Evaluate States for Dashboard & Entry                            |
//+------------------------------------------------------------------+
void EvaluateDashboardStates() {
    double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK);
    double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);
    
    // --- 1. News ---
    d_is_news_time = IsNewsTime();
    bool is_eod_restricted = IsEndOfDayRestricted();
    
    // Check structural unretested fractals
    EvaluateUnretestedFractals();

    // Evaluate Ranging State
    d_is_ranging = false;
    if (Use_Ranging_Filter && adx_ranging[0] > 0) {
        if (adx_ranging[0] <= Ranging_ADX_Threshold) {
            d_is_ranging = true;
        }
    }

    // --- M1 HH/LL Momentum Logic ---
    d_m1_is_ranging = false;
    d_m1_mom_trend = 0;
    d_m1_hh_ratio = 50.0;
    
    if(Use_M1_Momentum) {
        int hh_count = 0;
        int ll_count = 0;
        int start_k = 1;
        if (M1_Mom_Include_Current) {
            start_k = 0;
        } else if (M1_Mom_Include_If_Broken) {
            if (iHigh(_Symbol, _Period, 0) > iHigh(_Symbol, _Period, 1) || 
                iLow(_Symbol, _Period, 0) < iLow(_Symbol, _Period, 1)) {
                start_k = 0;
            }
        }
        for(int k = start_k; k < M1_Mom_Lookback + start_k; k++) {
            if(iHigh(_Symbol, _Period, k) > iHigh(_Symbol, _Period, k+1)) hh_count++;
            if(iLow(_Symbol, _Period, k) < iLow(_Symbol, _Period, k+1)) ll_count++;
        }
        int total_moves = hh_count + ll_count;
        if(total_moves > 0) {
            d_m1_hh_ratio = ((double)hh_count / (double)total_moves) * 100.0;
        }
        
        if(d_m1_hh_ratio >= M1_Mom_Trend_Threshold) d_m1_mom_trend = 1; // Strong UP
        else if(d_m1_hh_ratio <= (100.0 - M1_Mom_Trend_Threshold)) d_m1_mom_trend = -1; // Strong DOWN
        
        if(d_m1_hh_ratio <= M1_Mom_Range_Threshold && d_m1_hh_ratio >= (100.0 - M1_Mom_Range_Threshold)) {
            d_m1_is_ranging = true;
        }
    }

    // --- 2. Live CT Spike Tracker ---
    current_ct_spike_atr_mult = 0.0;
    int safe_ct_shift = CT_Spike_ATR_Shift;
    if(safe_ct_shift >= ArraySize(atr_m1)) safe_ct_shift = ArraySize(atr_m1) - 1;
    
    if(atr_m1[safe_ct_shift] > 0) {
        double max_h = 0.0; double min_l = 999999.0;
        for(int k = 0; k < CT_Spike_Lookback_Bars; k++) {
            double h = iHigh(_Symbol, _Period, k); double l = iLow(_Symbol, _Period, k);
            if(h > max_h) max_h = h; if(l < min_l) min_l = l;
        }
        current_ct_spike_atr_mult = (max_h - min_l) / atr_m1[safe_ct_shift];
    }

    // --- 3. H1 Trend & Zone ---
    // Compute RSI-adaptive extreme zone percentages for this tick
    d_h1_zone_buy_pct = GetDynamicH1ZonePct(true);   // NEW
    d_h1_zone_sel_pct = GetDynamicH1ZonePct(false);  // NEW

    d_h1_trend = 0; 
    if(Use_Trend_Filter) {
        if(Trend_Method == TREND_BB_SLOPE) {
            bool up = true, dn = true;
            for(int i = 0; i < BBSlope_Lookback; i++) { if(hist_base_h1[i] <= hist_base_h1[i+1]) up = false; if(hist_base_h1[i] >= hist_base_h1[i+1]) dn = false; }
            double h1_close = iClose(_Symbol, InpHTF2, 0);
            if(up && h1_close > hist_base_h1[0]) d_h1_trend = 1; if(dn && h1_close < hist_base_h1[0]) d_h1_trend = -1;
        } 
        else if(Trend_Method == TREND_ADX) {
            if(adx_h1[0] >= ADX_Threshold) { 
                if(!ADX_Dir_From_Mean) {
                    if(plus_di_h1[0] > minus_di_h1[0]) d_h1_trend = 1; else if(minus_di_h1[0] > plus_di_h1[0]) d_h1_trend = -1; 
                } else {
                    double h1_close = iClose(_Symbol, InpHTF2, 0);
                    if(h1_close > bb_base_h1[0]) d_h1_trend = 1; else d_h1_trend = -1;
                }
            }
        }
    }
    
    d_m5_trend = 0; 
    if(Use_M5_Trend_Filter) {
        if(Trend_Method == TREND_BB_SLOPE) {
            bool up = true, dn = true;
            for(int i = 0; i < BBSlope_Lookback; i++) { if(hist_base_m5[i] <= hist_base_m5[i+1]) up = false; if(hist_base_m5[i] >= hist_base_m5[i+1]) dn = false; }
            double m5_close = iClose(_Symbol, InpHTF1, 0);
            if(up && m5_close > hist_base_m5[0]) d_m5_trend = 1; if(dn && m5_close < hist_base_m5[0]) d_m5_trend = -1;
        } 
        else if(Trend_Method == TREND_ADX) {
            if(adx_m5[0] >= ADX_Threshold) { 
                if(!ADX_Dir_From_Mean) {
                    if(plus_di_m5[0] > minus_di_m5[0]) d_m5_trend = 1; else if(minus_di_m5[0] > plus_di_m5[0]) d_m5_trend = -1; 
                } else {
                    double m5_close = iClose(_Symbol, InpHTF1, 0);
                    if(m5_close > bb_base_m5[0]) d_m5_trend = 1; else d_m5_trend = -1;
                }
            }
        }
    }

    // COMPUTE DYNAMIC MEAN ZONES (Can be scaled by ADX or recently computed RSI/Trend)
    d_h1_mean_zone_pct = GetDynamicMeanZonePct(adx_h1[0], d_rsi_h1_value, d_h1_trend, MeanZonePct);
    d_m5_mean_zone_pct = GetDynamicMeanZonePct(adx_m5[0], d_rsi_m5_value, d_m5_trend, MeanZonePct_M5);

    double h1_range = bb_up_h1[0] - bb_dn_h1[0];
    bool is_ct_spike = Allow_CT_On_Spikes ? IsCurrentSpike(CT_Spike_Lookback_Bars, CT_Spike_ATR_Multiplier, CT_Spike_ATR_Shift) : false;

    // Use RSI-adaptive zone percentages in all H1 zone checks (CHANGED)
    if (d_h1_trend == 1) { 
        d_h1_buy = (bid <= (bb_base_h1[0] + (h1_range * d_h1_mean_zone_pct))); 
        d_h1_sell = (Block_Counter_Trend && !is_ct_spike) ? false : ValidMTFZone(ask, bb_dn_h1[0], bb_up_h1[0], false, d_h1_zone_sel_pct); 
    } 
    else if (d_h1_trend == -1) { 
        d_h1_sell = (ask >= (bb_base_h1[0] - (h1_range * d_h1_mean_zone_pct))); 
        d_h1_buy = (Block_Counter_Trend && !is_ct_spike) ? false : ValidMTFZone(bid, bb_dn_h1[0], bb_up_h1[0], true, d_h1_zone_buy_pct); 
    } 
    else { 
        d_h1_buy  = ValidMTFZone(bid, bb_dn_h1[0], bb_up_h1[0], true,  d_h1_zone_buy_pct); 
        d_h1_sell = ValidMTFZone(ask, bb_dn_h1[0], bb_up_h1[0], false, d_h1_zone_sel_pct); 
    }

    h1_dash_txt = "WAITING"; h1_dash_col = clrDimGray;
    if(d_h1_trend == 1) { // UP TREND
        if(d_h1_buy) { h1_dash_txt = "BUY VALID (UP Trend: Mean & Below)"; h1_dash_col = clrGreen; }
        else if(ValidMTFZone(ask, bb_dn_h1[0], bb_up_h1[0], false, d_h1_zone_sel_pct)) {  // CHANGED
            if(!Block_Counter_Trend) { h1_dash_txt = "SELL VALID (UP Trend: CT Allowed)"; h1_dash_col = clrDarkOrange; }
            else if(is_ct_spike) { h1_dash_txt = "SELL VALID (UP Trend: CT Spike Bypass)"; h1_dash_col = clrPurple; }
            else { h1_dash_txt = "SELL BLOCKED (UP Trend: Need CT Spike)"; h1_dash_col = clrRed; }
        }
    } else if(d_h1_trend == -1) { // DOWN TREND
        if(d_h1_sell) { h1_dash_txt = "SELL VALID (DOWN Trend: Mean & Above)"; h1_dash_col = clrRed; }
        else if(ValidMTFZone(bid, bb_dn_h1[0], bb_up_h1[0], true, d_h1_zone_buy_pct)) {  // CHANGED
            if(!Block_Counter_Trend) { h1_dash_txt = "BUY VALID (DOWN Trend: CT Allowed)"; h1_dash_col = clrDarkOrange; }
            else if(is_ct_spike) { h1_dash_txt = "BUY VALID (DOWN Trend: CT Spike Bypass)"; h1_dash_col = clrPurple; }
            else { h1_dash_txt = "BUY BLOCKED (DOWN Trend: Need CT Spike)"; h1_dash_col = clrRed; }
        }
    } else {
        if(d_h1_buy)  { h1_dash_txt = "BUY VALID (Extreme Bottom)"; h1_dash_col = clrGreen; }
        else if(d_h1_sell) { h1_dash_txt = "SELL VALID (Extreme Top)"; h1_dash_col = clrRed; }
    }

    // --- 4. M5 Zone ---
    double m5_range = bb_up_m5[0] - bb_dn_m5[0];
    if (d_m5_trend == 1) { 
        d_m5_buy = (bid <= (bb_base_m5[0] + (m5_range * d_m5_mean_zone_pct))); 
        d_m5_sell = ValidMTFZone(ask, bb_dn_m5[0], bb_up_m5[0], false, M5_Extreme_Zone_Pct); 
    } 
    else if (d_m5_trend == -1) { 
        d_m5_sell = (ask >= (bb_base_m5[0] - (m5_range * d_m5_mean_zone_pct))); 
        d_m5_buy = ValidMTFZone(bid, bb_dn_m5[0], bb_up_m5[0], true, M5_Extreme_Zone_Pct); 
    } 
    else { 
        d_m5_buy  = ValidMTFZone(bid, bb_dn_m5[0], bb_up_m5[0], true,  M5_Extreme_Zone_Pct); 
        d_m5_sell = ValidMTFZone(ask, bb_dn_m5[0], bb_up_m5[0], false, M5_Extreme_Zone_Pct); 
    }

    // --- 5. Fib 50% & 38.2% Dynamic ---
    double highest = iHigh(_Symbol, _Period, iHighest(_Symbol, _Period, MODE_HIGH, SwingLookback, 1)); 
    double lowest = iLow(_Symbol, _Period, iLowest(_Symbol, _Period, MODE_LOW, SwingLookback, 1)); 
    double fib_range = highest - lowest;
    
    d_fib50 = lowest + (fib_range / 2.0);
    d_fib_active_buy = d_fib50;
    d_fib_active_sell = d_fib50;
    
    bool fib38_buy_active = false;
    bool fib38_sell_active = false;
    
    if(Use_Fib38_Trending) {
        if(d_h1_trend == 1 && d_rsi_h1_value >= RSI_Strong_Up) {
            d_fib_active_buy = highest - (fib_range * 0.382);
            fib38_buy_active = true;
        }
        if(d_h1_trend == -1 && d_rsi_h1_value <= RSI_Strong_Dn) {
            d_fib_active_sell = lowest + (fib_range * 0.382);
            fib38_sell_active = true;
        }
    }
    
    if(!Use_Fib50_Filter) d_pd_status = "DISABLED (BUY/SELL OK)";
    else if(bid < d_fib_active_buy) {
         if(fib38_buy_active && bid >= d_fib50) d_pd_status = "DISCOUNT (BUY OK - 38.2%)";
         else d_pd_status = "DISCOUNT (BUY OK)";
    }
    else if(ask > d_fib_active_sell) {
         if(fib38_sell_active && ask <= d_fib50) d_pd_status = "PREMIUM (SELL OK - 38.2%)";
         else d_pd_status = "PREMIUM (SELL OK)";
    }
    else d_pd_status = "MIDDLE (WAIT)";

    // --- 6. Squeeze & M1 Band Piercing ---
    if(Use_Squeeze_Filter) {
        d_sqz_m1 = IsM1Squeezed(); 
        d_sqz_m5 = IsM5Squeezed(); 
        d_sqz_h1 = IsH1Squeezed();
        is_squeeze = (d_sqz_m1 || d_sqz_m5 || d_sqz_h1);

        // --- H1 Squeeze State Machine ---
        if(!Use_H1_Squeeze_Filter) {
            h1_squeeze_danger = false;
            h1_post_squeeze_release = false;
        } else if(d_sqz_h1) {
            h1_squeeze_danger = true;
            h1_post_squeeze_release = false;
            h1_sqz_release_dir = 0;
        } else if(h1_squeeze_danger) {
            // Squeeze just popped
            h1_squeeze_danger = false;
            h1_post_squeeze_release = true;
            h1_sqz_release_dir = (iClose(_Symbol, InpHTF2, 0) > bb_base_h1[0]) ? 1 : -1;
            h1_sqz_mss_level = (h1_sqz_release_dir == 1) ? GetMostRecentFractalLow(2) : GetMostRecentFractalHigh(2);
        }

        // --- M5 Squeeze State Machine ---
        if(!Use_M5_Squeeze_Filter) {
            m5_squeeze_danger = false;
            m5_post_squeeze_release = false;
        } else if(d_sqz_m5) {
            m5_squeeze_danger = true;
            m5_post_squeeze_release = false;
            m5_sqz_release_dir = 0;
        } else if(m5_squeeze_danger) {
            m5_squeeze_danger = false;
            m5_post_squeeze_release = true;
            m5_sqz_release_dir = (iClose(_Symbol, InpHTF1, 0) > bb_base_m5[0]) ? 1 : -1;
            m5_sqz_mss_level = (m5_sqz_release_dir == 1) ? GetMostRecentFractalLow(2) : GetMostRecentFractalHigh(2);
        }

        // --- M1 Squeeze State Machine ---
        if(!Use_M1_Squeeze_Filter) {
            m1_squeeze_danger = false;
            m1_post_squeeze_release = false;
        } else if(d_sqz_m1) {
            m1_squeeze_danger = true;
            m1_post_squeeze_release = false;
            m1_sqz_release_dir = 0;
        } else if(m1_squeeze_danger) {
            m1_squeeze_danger = false;
            m1_post_squeeze_release = true;
            m1_sqz_release_dir = (bid > bb_base_m1[0]) ? 1 : -1;
            m1_sqz_mss_level = (m1_sqz_release_dir == 1) ? GetMostRecentFractalLow(2) : GetMostRecentFractalHigh(2);
        }

        // --- Evaluate MSS to Clear Post-Squeeze WARNINGS ---
        
        // Helper string constants for objects
        string h1_mss_obj = "MSS_Squeeze_H1";
        string m5_mss_obj = "MSS_Squeeze_M5";
        string m1_mss_obj = "MSS_Squeeze_M1";

        // H1 Evaluation
        if(h1_post_squeeze_release) {
            if(h1_sqz_release_dir == 1) { // Upward break, tracking lows
                double new_f = GetMostRecentFractalLow(2);
                if(new_f > 0 && new_f > h1_sqz_mss_level) h1_sqz_mss_level = new_f; // Trail it up
                if(bid < h1_sqz_mss_level) { h1_post_squeeze_release = false; ObjectDelete(0, h1_mss_obj); } // MSS Down -> Clear
            } else if(h1_sqz_release_dir == -1) { // Downward break, tracking highs
                double new_f = GetMostRecentFractalHigh(2);
                if(new_f > 0 && new_f < h1_sqz_mss_level) h1_sqz_mss_level = new_f; // Trail it down
                if(ask > h1_sqz_mss_level) { h1_post_squeeze_release = false; ObjectDelete(0, h1_mss_obj); } // MSS Up -> Clear
            }
            if(h1_post_squeeze_release && h1_sqz_mss_level > 0) {
                if(!Disable_Chart_Visuals) {
                    if(ObjectFind(0, h1_mss_obj) < 0) ObjectCreate(0, h1_mss_obj, OBJ_HLINE, 0, 0, h1_sqz_mss_level);
                    ObjectSetDouble(0, h1_mss_obj, OBJPROP_PRICE, h1_sqz_mss_level);
                    ObjectSetInteger(0, h1_mss_obj, OBJPROP_COLOR, clrOrange);
                    ObjectSetInteger(0, h1_mss_obj, OBJPROP_STYLE, STYLE_DASH);
                    ObjectSetInteger(0, h1_mss_obj, OBJPROP_WIDTH, 2);
                } else { ObjectDelete(0, h1_mss_obj); }
            } else { ObjectDelete(0, h1_mss_obj); }
        } else { ObjectDelete(0, h1_mss_obj); }

        // M5 Evaluation
        if(m5_post_squeeze_release) {
            if(m5_sqz_release_dir == 1) { // Upward break, tracking lows
                double new_f = GetMostRecentFractalLow(2);
                if(new_f > 0 && new_f > m5_sqz_mss_level) m5_sqz_mss_level = new_f; 
                if(bid < m5_sqz_mss_level) { m5_post_squeeze_release = false; ObjectDelete(0, m5_mss_obj); }
            } else if(m5_sqz_release_dir == -1) { // Downward break, tracking highs
                double new_f = GetMostRecentFractalHigh(2);
                if(new_f > 0 && new_f < m5_sqz_mss_level) m5_sqz_mss_level = new_f; 
                if(ask > m5_sqz_mss_level) { m5_post_squeeze_release = false; ObjectDelete(0, m5_mss_obj); }
            }
            if(m5_post_squeeze_release && m5_sqz_mss_level > 0) {
                if(!Disable_Chart_Visuals) {
                    if(ObjectFind(0, m5_mss_obj) < 0) ObjectCreate(0, m5_mss_obj, OBJ_HLINE, 0, 0, m5_sqz_mss_level);
                    ObjectSetDouble(0, m5_mss_obj, OBJPROP_PRICE, m5_sqz_mss_level);
                    ObjectSetInteger(0, m5_mss_obj, OBJPROP_COLOR, clrOrange);
                    ObjectSetInteger(0, m5_mss_obj, OBJPROP_STYLE, STYLE_DOT);
                    ObjectSetInteger(0, m5_mss_obj, OBJPROP_WIDTH, 1);
                } else { ObjectDelete(0, m5_mss_obj); }
            } else { ObjectDelete(0, m5_mss_obj); }
        } else { ObjectDelete(0, m5_mss_obj); }

        // M1 Evaluation
        if(m1_post_squeeze_release) {
            if(m1_sqz_release_dir == 1) { // Upward break, tracking lows
                double new_f = GetMostRecentFractalLow(2);
                if(new_f > 0 && new_f > m1_sqz_mss_level) m1_sqz_mss_level = new_f; 
                if(bid < m1_sqz_mss_level) { m1_post_squeeze_release = false; ObjectDelete(0, m1_mss_obj); }
            } else if(m1_sqz_release_dir == -1) { // Downward break, tracking highs
                double new_f = GetMostRecentFractalHigh(2);
                if(new_f > 0 && new_f < m1_sqz_mss_level) m1_sqz_mss_level = new_f; 
                if(ask > m1_sqz_mss_level) { m1_post_squeeze_release = false; ObjectDelete(0, m1_mss_obj); }
            }
            if(m1_post_squeeze_release && m1_sqz_mss_level > 0) {
                if(!Disable_Chart_Visuals) {
                    if(ObjectFind(0, m1_mss_obj) < 0) ObjectCreate(0, m1_mss_obj, OBJ_HLINE, 0, 0, m1_sqz_mss_level);
                    ObjectSetDouble(0, m1_mss_obj, OBJPROP_PRICE, m1_sqz_mss_level);
                    ObjectSetInteger(0, m1_mss_obj, OBJPROP_COLOR, clrCoral);
                    ObjectSetInteger(0, m1_mss_obj, OBJPROP_STYLE, STYLE_DOT);
                    ObjectSetInteger(0, m1_mss_obj, OBJPROP_WIDTH, 1);
                } else { ObjectDelete(0, m1_mss_obj); }
            } else { ObjectDelete(0, m1_mss_obj); }
        } else { ObjectDelete(0, m1_mss_obj); }

    } else {
        d_sqz_m1 = false; d_sqz_m5 = false; d_sqz_h1 = false; is_squeeze = false;
        h1_squeeze_danger = false; h1_post_squeeze_release = false;
        m5_squeeze_danger = false; m5_post_squeeze_release = false;
        m1_squeeze_danger = false; m1_post_squeeze_release = false;
    }

    // --- 6d. 1M Squeeze + Major Liquidity Synergy ---
    CheckM1SqueezeLiquiditySynergy();

    double buy_extreme = is_squeeze ? (bb_dn_m1[0] - (atr_m1[0] * 0.5)) : bb_dn_m1[0]; 
    double sell_extreme = is_squeeze ? (bb_up_m1[0] + (atr_m1[0] * 0.5)) : bb_up_m1[0];
    
    // Default Rule: Must pierce or exactly touch the extreme band/squeeze offset
    d_extreme_buy = (bid <= buy_extreme);
    d_extreme_sell = (ask >= sell_extreme);

    // --- M1 Momentum Bypass ---
    m1_mom_bypass_active_buy = false;
    m1_mom_bypass_active_sell = false;
    if(Use_M1_Momentum && M1_Mom_Bypass_Extreme) {
        double m1_range = (bb_up_m1[0] - bb_dn_m1[0]);
        double near_dist = m1_range * M1_Mom_Bypass_Near_Pct;
        
        // Reset visualization globals before computing
        g_mb_push_size = 0; g_mb_prev_size = 0; g_mb_ratio = 0;
        g_mb_start_idx = -1; g_mb_end_idx = -1; 
        g_mb_prev_start_idx = -1; g_mb_prev_end_idx = -1;
        g_mb_is_valid = false;
        g_mb_trend_dir = 0;
        
        // Find the most recent strong momentum within the lookback
        int recent_strong_idx = -1;
        int recent_trend_dir = 0;
        
        for(int k = 0; k <= M1_Mom_Bypass_Lookback; k++) {
            int hist_trend = GetHistoricalM1MomTrend(k);
            if(hist_trend != 0) {
                recent_strong_idx = k;
                recent_trend_dir = hist_trend;
                break;
            }
        }
        
        if(recent_strong_idx != -1) {
            // Find the start of this specific push
            int start_idx = recent_strong_idx;
            while(start_idx < Bars(_Symbol, _Period) && GetHistoricalM1MomTrend(start_idx + 1) == recent_trend_dir) {
                start_idx++;
            }
            
            // Calculate push size
            double push_max = 0.0, push_min = 999999.0;
            for(int k = recent_strong_idx; k <= start_idx; k++) {
                if(iHigh(_Symbol, _Period, k) > push_max) push_max = iHigh(_Symbol, _Period, k);
                if(iLow(_Symbol, _Period, k) < push_min) push_min = iLow(_Symbol, _Period, k);
            }
            double push_size = push_max - push_min;
            
            // Calculate previous timeframe size
            int prev_start = start_idx + 1;
            int prev_end = prev_start + M1_Mom_Bypass_Prev_Bars - 1;
            double prev_max = 0.0, prev_min = 999999.0;
            
            if (prev_end < Bars(_Symbol, _Period)) {
                for(int k = prev_start; k <= prev_end; k++) {
                    if(iHigh(_Symbol, _Period, k) > prev_max) prev_max = iHigh(_Symbol, _Period, k);
                    if(iLow(_Symbol, _Period, k) < prev_min) prev_min = iLow(_Symbol, _Period, k);
                }
                double prev_size = prev_max - prev_min;
                
                // Store in globals
                g_mb_push_size = push_size;
                g_mb_prev_size = prev_size;
                if(prev_size > 0) g_mb_ratio = push_size / prev_size; else g_mb_ratio = 999.0;
                g_mb_start_idx = start_idx;
                g_mb_end_idx = recent_strong_idx;
                g_mb_prev_start_idx = prev_start;
                g_mb_prev_end_idx = prev_end;
                g_mb_trend_dir = recent_trend_dir;
                
                // Avoid division by zero and measure if push was big enough
                if(prev_size > 0 && push_size >= (prev_size * M1_Mom_Bypass_Multiplier)) {
                    g_mb_is_valid = true;
                
                    // Down momentum (strong push down) -> Buy bypass if near lower band
                    if(recent_trend_dir == -1 && bid <= (buy_extreme + near_dist)) {
                        d_extreme_buy = true;
                        m1_mom_bypass_active_buy = true;
                    }
                    
                    // Up momentum (strong push up) -> Sell bypass if near upper band
                    if(recent_trend_dir == 1 && ask >= (sell_extreme - near_dist)) {
                        d_extreme_sell = true;
                        m1_mom_bypass_active_sell = true;
                    }
                }
            }
        }
    }



    // --- 7. Liquidity Sweep ---
    bool disable_deep_buy = (DeepSweep_M1_Bypass_Disable && m1_mom_bypass_active_buy);
    bool disable_deep_sell = (DeepSweep_M1_Bypass_Disable && m1_mom_bypass_active_sell);
    
    string current_sweep_type_buy = "";
    double current_sweep_price_buy = 0.0;
    bool current_d_sweep_buy = CheckLiquiditySweepRealTime(true, bid, current_sweep_type_buy, current_sweep_price_buy, disable_deep_buy);
    
    string current_sweep_type_sell = "";
    double current_sweep_price_sell = 0.0;
    bool current_d_sweep_sell = CheckLiquiditySweepRealTime(false, ask, current_sweep_type_sell, current_sweep_price_sell, disable_deep_sell);
    
    datetime current_bar = iTime(_Symbol, _Period, 0);

    // Buy Sweep Latching (Maintain valid status until a generic bullish candle completes)
    if(current_d_sweep_buy) {
        d_sweep_buy_latched = true;
        sweep_buy_bar = current_bar;
        latched_sweep_type_buy = current_sweep_type_buy;
        latched_sweep_price_buy = current_sweep_price_buy;
    } else if(d_sweep_buy_latched) {
        int sweep_idx = iBarShift(_Symbol, _Period, sweep_buy_bar);
        if(sweep_idx > 0) {
            for(int i = 1; i <= sweep_idx; i++) {
                if(iClose(_Symbol, _Period, i) > iOpen(_Symbol, _Period, i)) {
                    d_sweep_buy_latched = false;
                    break;
                }
            }
        } else if (sweep_idx < 0) {
            d_sweep_buy_latched = false;
        }
    }
    
    // Sell Sweep Latching (Maintain valid status until a generic bearish candle completes)
    if(current_d_sweep_sell) {
        d_sweep_sell_latched = true;
        sweep_sell_bar = current_bar;
        latched_sweep_type_sell = current_sweep_type_sell;
        latched_sweep_price_sell = current_sweep_price_sell;
    } else if(d_sweep_sell_latched) {
        int sweep_idx = iBarShift(_Symbol, _Period, sweep_sell_bar);
        if(sweep_idx > 0) {
            for(int i = 1; i <= sweep_idx; i++) {
                if(iClose(_Symbol, _Period, i) < iOpen(_Symbol, _Period, i)) {
                    d_sweep_sell_latched = false;
                    break;
                }
            }
        } else if (sweep_idx < 0) {
            d_sweep_sell_latched = false;
        }
    }

    d_sweep_buy = d_sweep_buy_latched;
    d_sweep_sell = d_sweep_sell_latched;

    // --- 8. Structural Clearance ---
    d_clear_buy = CheckStructuralClearance(true, bid); 
    d_clear_sell = CheckStructuralClearance(false, ask);

    // --- Speed Calc ---
    current_speed = 0.0; 
    current_speed_up = 0.0;
    current_speed_down = 0.0;
    
    MqlTick ticks[];
    if(CopyTicks(_Symbol, ticks, COPY_TICKS_ALL, 0, 10) == 10) { 
        long time_diff = ticks[9].time_msc - ticks[0].time_msc; 
        if(time_diff > 0) {
            double price_diff = ticks[9].bid - ticks[0].bid;
            double pips_diff = price_diff / _Point;
            double time_sec = (double)time_diff / 1000.0;
            
            current_speed = MathAbs(pips_diff) / time_sec;
            
            if(pips_diff > 0) current_speed_up = pips_diff / time_sec;
            if(pips_diff < 0) current_speed_down = pips_diff / time_sec; // Now subzero
        } 
    }

}

//+------------------------------------------------------------------+
//| Calculate Net Profit based on daily shifts (0=today, 1=yesterday)|
//+------------------------------------------------------------------+
double GetHistoryProfitByShift(int start_shift, int end_shift, ENUM_TIMEFRAMES tf = PERIOD_D1) {
    double profit = 0.0;
    datetime start_time = iTime(_Symbol, tf, start_shift);
    datetime end_time = (end_shift <= 0) ? TimeCurrent() : (iTime(_Symbol, tf, end_shift - 1) - 1);
    
    if(start_time <= 0) return 0.0;
    
    if(HistorySelect(start_time, end_time)) {
        int deals = HistoryDealsTotal();
        for(int i = 0; i < deals; i++) {
            ulong ticket = HistoryDealGetTicket(i);
            if(ticket > 0) {
                if(HistoryDealGetString(ticket, DEAL_SYMBOL) == _Symbol && HistoryDealGetInteger(ticket, DEAL_MAGIC) == MagicNumber) {
                    long entry_type = HistoryDealGetInteger(ticket, DEAL_ENTRY);
                    // Only sum profit/commission/swap on EXITS (out or inout)
                    if(entry_type == DEAL_ENTRY_OUT || entry_type == DEAL_ENTRY_INOUT || entry_type == DEAL_ENTRY_OUT_BY) {
                        profit += HistoryDealGetDouble(ticket, DEAL_PROFIT);
                        profit += HistoryDealGetDouble(ticket, DEAL_COMMISSION);
                        profit += HistoryDealGetDouble(ticket, DEAL_SWAP);
                    }
                }
            }
        }
    }
    return profit;
}

void DrawDashboard() {
    datetime current_time = TimeCurrent();
    int current_positions = PositionsTotal();
    
    if(current_time - last_pl_calc_time >= 60 || current_positions != cached_positions_total) {
        cached_daily_net = GetHistoryProfitByShift(0, 0);
        cached_prev_net  = GetHistoryProfitByShift(1, 1);
        cached_five_net  = GetHistoryProfitByShift(4, 0);
        cached_mtd_net   = GetHistoryProfitByShift(0, 0, PERIOD_MN1);
        last_pl_calc_time = current_time;
        cached_positions_total = current_positions;
    }

    int x = 20, y = 20, gap = 18; color c_buy = clrGreen, c_sell = clrRed, c_wait = clrDimGray, c_text = clrBlack;

    string net_str = StringFormat("[ Net D1: %.2f ]", cached_daily_net);
    color net_col = (cached_daily_net > 0) ? clrGreen : ((cached_daily_net < 0) ? clrRed : clrGray);

    y+=gap;
    MqlDateTime dt_gmt, dt_server;
    TimeGMT(dt_gmt);
    TimeCurrent(dt_server);
    string gmt_str = StringFormat("%02d:%02d", dt_gmt.hour, dt_gmt.min);
    string server_str = StringFormat("%02d:%02d", dt_server.hour, dt_server.min);
    DrawLabel("dash_title", StringFormat("[ Bands Sweeper v2.1 | GMT: %s / Server: %s ]", gmt_str, server_str), x + 150, y, clrBlue);
    DrawLabel("dash_daily_net", net_str, x, y, net_col);
    
    y+=gap;
    string hist_str = StringFormat("[ Prev D1: %.2f | Last 5 Days: %.2f | MTD: %.2f ]", cached_prev_net, cached_five_net, cached_mtd_net);
    color hist_col = (cached_mtd_net > 0) ? clrGreen : ((cached_mtd_net < 0) ? clrRed : clrGray);
    DrawLabel("dash_hist_net", hist_str, x, y, hist_col);
    
    // ==========================================
    // SECTION 1: LIVE ENTRY CHECKLIST
    // ==========================================
    DrawLabel("dash_div1", "--- LIVE ENTRY CHECKLIST ---", x, y+=gap, clrBlue);

    if(Use_Ranging_Filter) {
        if(d_is_ranging) {
            string bypass_str = "";
            if(ADX_Range_Bypass_H1 && ADX_Range_Bypass_M5) bypass_str = " (M5/H1 Bypassed)";
            else if(ADX_Range_Bypass_H1) bypass_str = " (H1 Bypassed)";
            else if(ADX_Range_Bypass_M5) bypass_str = " (M5 Bypassed)";
            
            DrawLabel("dash_chk_ranging", StringFormat("[0] Market State: RANGING%s | ADX: %.1f", bypass_str, adx_ranging[0]), x, y+=gap, clrDarkGoldenrod);
        } else {
            string tr_dir = "NEUTRAL";
            if(d_h1_trend == 1) tr_dir = "UP";
            else if(d_h1_trend == -1) tr_dir = "DOWN";
            DrawLabel("dash_chk_ranging", StringFormat("[0] Market State: TRENDING %s | ADX: %.1f", tr_dir, adx_ranging[0]), x, y+=gap, clrGreen);
        }
    }

    if(Use_News_Filter) DrawLabel("dash_chk_news", "[1] News Filter: " + (d_is_news_time ? "PAUSED (High Impact)" : "CLEAR"), x, y+=gap, d_is_news_time ? clrRed : clrGreen);
    string eod_hrs_txt = "";
    color eod_hrs_col = clrGreen;
    if (Use_EOD_Filter) {
        eod_hrs_txt = "[1a] EOD Filter: " + (IsEndOfDayRestricted() ? "PAUSED (Near Daily Close)" : "CLEAR");
        if (IsEndOfDayRestricted()) eod_hrs_col = clrRed;
    }
    if (Use_Trading_Hours) {
        MqlDateTime dt_cur;
        TimeCurrent(dt_cur);
        bool is_blocked = IsTradingHourBlocked();
        string blk_txt = "Blocked Hrs: " + (is_blocked ? StringFormat("PAUSED (Hour %02d)", dt_cur.hour) : "CLEAR");
        if (eod_hrs_txt == "") eod_hrs_txt = "[1a] " + blk_txt;
        else eod_hrs_txt += " | " + blk_txt;
        if (is_blocked) eod_hrs_col = clrRed;
    }
    if (eod_hrs_txt != "") {
        DrawLabel("dash_chk_eod", eod_hrs_txt, x, y+=gap, eod_hrs_col);
    }
    
    string htf2_str = StringSubstr(EnumToString(InpHTF2), 7);
    bool is_h1_bypassed = (d_is_ranging && ADX_Range_Bypass_H1);
    string d_h1_txt = is_h1_bypassed ? "BYPASSED (Ranging)" : h1_dash_txt;
    color  d_h1_col = is_h1_bypassed ? clrDarkGoldenrod : h1_dash_col;
    DrawLabel("dash_chk_h1", "[2] " + htf2_str + " Zone & Trend: " + d_h1_txt, x, y+=gap, d_h1_col);
    
    string m5_txt = "WAITING"; color m5_col = c_wait;
    bool is_m5_bypassed = (d_is_ranging && ADX_Range_Bypass_M5);
    
    if(is_m5_bypassed) { m5_txt = "BYPASSED (Ranging)"; m5_col = clrDarkGoldenrod; }
    else if(d_m5_trend == 1) {
        if(d_m5_buy) { m5_txt = "BUY VALID (Trend Mean & Below)"; m5_col = c_buy; }
        else if(d_m5_sell) { m5_txt = "SELL VALID (Extreme Top)"; m5_col = c_sell; }
    } else if(d_m5_trend == -1) {
        if(d_m5_sell) { m5_txt = "SELL VALID (Trend Mean & Above)"; m5_col = c_sell; }
        else if(d_m5_buy) { m5_txt = "BUY VALID (Extreme Bottom)"; m5_col = c_buy; }
    } else {
        if(d_m5_buy) { m5_txt = "BUY VALID (Extreme Bottom)"; m5_col = c_buy; }
        else if(d_m5_sell) { m5_txt = "SELL VALID (Extreme Top)"; m5_col = c_sell; }
    }
    string htf1_str = StringSubstr(EnumToString(InpHTF1), 7);
    DrawLabel("dash_chk_m5", "[3] " + htf1_str + " Zone: " + m5_txt, x, y+=gap, m5_col);

    color pd_col = c_wait; 
    if(!Use_Fib50_Filter) pd_col = clrGray; 
    else if(d_pd_status == "DISCOUNT (BUY OK)") pd_col = c_buy; 
    else if(d_pd_status == "PREMIUM (SELL OK)") pd_col = c_sell;
    
    DrawLabel("dash_chk_pd", "[4] Fib 50% PD: " + d_pd_status, x, y+=gap, pd_col);

    if(Use_Clearance_Filter) {
        string clr_txt = "WAITING"; color clr_col = c_wait;
        if(d_clear_buy && d_clear_sell) { clr_txt = "BUY & SELL OK"; clr_col = clrGreen; }
        else if(d_clear_buy) { clr_txt = "BUY OK"; clr_col = c_buy; }
        else if(d_clear_sell) { clr_txt = "SELL OK"; clr_col = c_sell; }
        DrawLabel("dash_chk_clr", "[5] Struct Clearance: " + clr_txt, x, y+=gap, clr_col);
    }

    string swp_txt = "WAITING"; color swp_col = c_wait;
    if(d_sweep_buy) { 
        swp_txt = latched_sweep_type_buy + " (Sell Side) Swept | BUY Allowed | " + DoubleToString(latched_sweep_price_buy, _Digits); 
        swp_col = c_buy; 
    }
    else if(d_sweep_sell) { 
        swp_txt = latched_sweep_type_sell + " (Buy Side) Swept | SELL Allowed | " + DoubleToString(latched_sweep_price_sell, _Digits); 
        swp_col = c_sell; 
    }
    
    if(Use_Deep_Sweep || Use_Normal_Sweep) {
        if(DeepSweep_M1_Bypass_Disable && (m1_mom_bypass_active_buy || m1_mom_bypass_active_sell)) {
            swp_txt += " (Req: OFF via Bypass)";
        } else {
            swp_txt += " (Req: ON)";
        }
    }
    
    DrawLabel("dash_chk_swp", "[6] Liquidity: " + swp_txt, x, y+=gap, swp_col);

    string ext_txt = "WAITING"; color ext_col = c_wait;
    if(d_extreme_buy) { 
        ext_txt = "BUY PIERCED"; ext_col = c_buy; 
        if(m1_mom_bypass_active_buy) ext_txt = "BUY NEAR (Mom Bypass)";
    }
    else if(d_extreme_sell) { 
        ext_txt = "SELL PIERCED"; ext_col = c_sell; 
        if(m1_mom_bypass_active_sell) ext_txt = "SELL NEAR (Mom Bypass)";
    }
    if(Use_Squeeze_Filter && is_squeeze) ext_txt += " (Squeeze Offset)";
    string tf_str = StringSubstr(EnumToString(_Period), 7);
    DrawLabel("dash_chk_ext", "[7] " + tf_str + " Extreme: " + ext_txt, x, y+=gap, ext_col);
    
    if(Use_Unretested_Fractal_Filter) {
        string ret_txt = "WAITING"; color ret_col = c_wait;
        if(d_retest_buy_ok && d_retest_sell_ok) { ret_txt = "BUY & SELL OK"; ret_col = clrGreen; }
        else if(d_retest_buy_ok) { ret_txt = "BUY OK (Sell Blocked)"; ret_col = c_buy; }
        else if(d_retest_sell_ok) { ret_txt = "SELL OK (Buy Blocked)"; ret_col = c_sell; }
        else { ret_txt = "ALL BLOCKED"; ret_col = clrRed; }
        DrawLabel("dash_chk_retest", "[7c] Struct Retest: " + ret_txt, x, y+=gap, ret_col);
    }

    double rt_pips = (iClose(_Symbol, _Period, 0) - iOpen(_Symbol, _Period, 0)) / _Point; 
    long rt_sec = TimeCurrent() - iTime(_Symbol, _Period, 0);
    if (rt_sec <= 0) rt_sec = 1;
    double rt_speed = rt_pips / (double)rt_sec;
    
    bool speed_ok = IsSpeedAllowed(rt_speed, AllowedSpeedRanges);
    string speed_stat_txt = speed_ok ? "OK" : "DENIED (Out of Bounds)";
    color speed_stat_col = speed_ok ? clrGreen : clrRed;
    DrawLabel("dash_chk_spd", "[8] Live Speed Bounds: " + speed_stat_txt, x, y+=gap, speed_stat_col);

    // ==========================================
    // SECTION 2: LIVE TRACKERS
    // ==========================================
    DrawLabel("dash_div2", "--- LIVE TRACKERS ---", x, y+=gap, clrBlue);

    // NEW: RSI Adaptive Zone tracker row
    if(Use_RSI_Zone_Adapt) {
        // Determine RSI momentum label and colour
        string rsi_mom_txt;
        color  rsi_mom_col;
        if(d_rsi_h1_value >= RSI_Strong_Up) {
            rsi_mom_txt = "Strong UP";   rsi_mom_col = clrGreen;
        } else if(d_rsi_h1_value <= RSI_Strong_Dn) {
            rsi_mom_txt = "Strong DOWN"; rsi_mom_col = clrRed;
        } else if(d_rsi_h1_value >= RSI_Weak_Level) {
            rsi_mom_txt = "Weak UP";     rsi_mom_col = clrDarkOrange;
        } else {
            rsi_mom_txt = "Weak DOWN";   rsi_mom_col = clrDarkOrange;
        }
        string rsi_row = StringFormat("%s RSI(%d): %.1f [%s] | BuyZone: %.0f%%  SellZone: %.0f%%",
                                      htf2_str, RSI_H1_Period, d_rsi_h1_value, rsi_mom_txt,
                                      d_h1_zone_buy_pct * 100.0,
                                      d_h1_zone_sel_pct * 100.0);
        DrawLabel("dash_rsi_zone", rsi_row, x, y+=gap, rsi_mom_col);
    } else {
        DrawLabel("dash_rsi_zone", htf2_str + " RSI Zone Adapt: DISABLED (fixed " + DoubleToString(H1_Extreme_Zone_Pct*100,0) + "%)", x, y+=gap, clrGray);
    }

    if(Use_Trend_Filter && Block_Counter_Trend && Allow_CT_On_Spikes) {
        string spike_txt = StringFormat("Live CT Spike (%d bars): %.2fx ATR (Shifted %d)", CT_Spike_Lookback_Bars, current_ct_spike_atr_mult, CT_Spike_ATR_Shift);
        color spike_col = (current_ct_spike_atr_mult >= CT_Spike_ATR_Multiplier) ? clrPurple : clrDimGray;
        DrawLabel("dash_live_spike", spike_txt, x, y+=gap, spike_col);
    }

    if(Use_M1_Momentum) {
        string m1_mom_txt;
        color m1_mom_col;
        if(d_m1_mom_trend == 1) { 
            m1_mom_txt = "M1 Mom: STRONG UP (" + DoubleToString(d_m1_hh_ratio, 0) + "% HH)"; 
            m1_mom_col = clrGreen; 
        }
        else if(d_m1_mom_trend == -1) { 
            m1_mom_txt = "M1 Mom: STRONG DOWN (" + DoubleToString(d_m1_hh_ratio, 0) + "% HH)"; 
            m1_mom_col = clrRed; 
        }
        else if(d_m1_is_ranging) {
            if(M1_Mom_Bypass_HTF) {
                m1_mom_txt = "M1 Mom: RANGING (" + DoubleToString(d_m1_hh_ratio, 0) + "% HH) -> HTF BYPASS"; 
            } else {
                m1_mom_txt = "M1 Mom: RANGING (" + DoubleToString(d_m1_hh_ratio, 0) + "% HH) -> NO BYPASS"; 
            }
            m1_mom_col = clrDarkGoldenrod; 
        }
        else {
            if(M1_Mom_Allow_Neutral) {
                m1_mom_txt = "M1 Mom: NEUTRAL (" + DoubleToString(d_m1_hh_ratio, 0) + "% HH) -> ALLOWED";
                m1_mom_col = clrGray;
            } else {
                m1_mom_txt = "M1 Mom: NEUTRAL (" + DoubleToString(d_m1_hh_ratio, 0) + "% HH) -> BLOCKED";
                m1_mom_col = clrIndianRed;
            }
        }
        
        DrawLabel("dash_m1_mom", m1_mom_txt, x, y+=gap, m1_mom_col);
        
        // NEW: M1 Bypass Panel Diagnostics (split to multiple lines if needed)
        if(M1_Mom_Bypass_Extreme) {
            if(g_mb_start_idx != -1) {
                string push_dir = (g_mb_trend_dir == 1) ? "UP" : "DN";
                string mb_line1 = StringFormat("M1 Bypass: Move %s | Push: %.2f | Prev: %.2f", 
                                                push_dir, g_mb_push_size, g_mb_prev_size);
                string mb_line2 = StringFormat("       -> Ratio: %.1f (Min %.1f) | %s", 
                                                g_mb_ratio, M1_Mom_Bypass_Multiplier, 
                                                (g_mb_is_valid ? "OK" : "DENIED"));
                
                color mb_col = g_mb_is_valid ? clrGreen : clrLightCoral;
                DrawLabel("dash_mb_diag1", mb_line1, x, y+=gap, mb_col);
                DrawLabel("dash_mb_diag2", mb_line2, x, y+=gap, mb_col);
            } else {
                DrawLabel("dash_mb_diag1", "M1 Bypass: WAITING PUSH", x, y+=gap, clrGray);
                DrawLabel("dash_mb_diag2", "", x, y, clrNONE); 
            }
        } else {
            DrawLabel("dash_mb_diag1", "", x, y, clrNONE);
            DrawLabel("dash_mb_diag2", "", x, y, clrNONE);
        }
        
    } else {
        DrawLabel("dash_m1_mom", "", x, y+=gap, clrNONE);
        DrawLabel("dash_mb_diag1", "", x, y, clrNONE);
        DrawLabel("dash_mb_diag2", "", x, y, clrNONE);
    }

    if(Use_Squeeze_Filter) {
        string sqz_status = "NONE"; color sqz_col = clrDimGray;
        if(d_sqz_m1) { sqz_status = tf_str + " ACTIVE"; sqz_col = clrDarkOrange; }
        if(d_sqz_m5) { sqz_status = d_sqz_m1 ? tf_str + " & " + htf1_str + " ACTIVE" : htf1_str + " ACTIVE"; sqz_col = clrDarkOrange; }
        if(d_sqz_h1) { sqz_status = htf2_str + " ACTIVE (Multiple)"; sqz_col = clrDarkOrange; }
        
        if (Use_M1_Squeeze_Filter || Use_M5_Squeeze_Filter || Use_H1_Squeeze_Filter) {
            DrawLabel("dash_sqz_stat", "Squeeze Status: " + sqz_status, x, y+=gap, sqz_col);
        } else {
            DrawLabel("dash_sqz_stat", "", x, y+=gap, clrNONE);
        }

        // H1 Squeeze Danger Row — prominent, separate from generic squeeze row
        if(Use_H1_Squeeze_Filter) {
            string h1sqz_txt; color h1sqz_col;
            string h1_atr_str = (ArraySize(atr_h1_hist) > 0 && atr_h1_hist[0] > 0) ? StringFormat(" [%.2fx ATR]", (bb_up_h1_hist[0] - bb_dn_h1_hist[0]) / atr_h1_hist[0]) : "";

            if(h1_squeeze_danger) {
                // Determine which method fired for diagnostic clarity
                string method = IsH1BarSqueezedByATR(0) ? "ATR" : "Rel";
                h1sqz_txt = "!! " + htf2_str + " SQUEEZE DANGER [" + method + "]: ACTIVE" + h1_atr_str;
                if(Block_Entry_On_H1_Squeeze) h1sqz_txt += " — Entries BLOCKED";
                if(Exit_Trade_On_H1_Squeeze)  h1sqz_txt += " | EXIT Armed";
                h1sqz_col = clrRed;
            } else if(h1_post_squeeze_release) {
                string dir_str = (h1_sqz_release_dir == 1) ? "UP" : "DN";
                h1sqz_txt = "! " + htf2_str + " POST-SQUEEZE: CAUTION (Dir: " + dir_str + ", MSS Lvl: " + DoubleToString(h1_sqz_mss_level, _Digits) + ")" + h1_atr_str;
                if(Block_Entry_On_H1_Squeeze) h1sqz_txt += " — Entries BLOCKED";
                if(H1_Squeeze_SL_Multiplier > 0) h1sqz_txt += " | SL=" + DoubleToString(H1_Squeeze_SL_Multiplier, 1) + "xATR";
                h1sqz_col = clrOrange;
            } else {
                h1sqz_txt = htf2_str + " Squeeze: Clear" + h1_atr_str;
                h1sqz_col = clrGray;
            }
            DrawLabel("dash_h1sqz", h1sqz_txt, x, y+=gap, h1sqz_col);
        } else {
            DrawLabel("dash_h1sqz", "", x, y+=gap, clrNONE);
        }
        
        // M5 Squeeze Danger Row
        if(Use_M5_Squeeze_Filter) {
            string m5sqz_txt; color m5sqz_col;
            string m5_atr_str = (ArraySize(atr_m5_hist) > 0 && atr_m5_hist[0] > 0) ? StringFormat(" [%.2fx ATR]", (bb_up_m5_hist[0] - bb_dn_m5_hist[0]) / atr_m5_hist[0]) : "";

            if(m5_squeeze_danger) {
                string method = IsM5BarSqueezedByATR(0) ? "ATR" : "Rel";
                m5sqz_txt = "!! " + htf1_str + " SQUEEZE DANGER [" + method + "]: ACTIVE" + m5_atr_str;
                if(Block_Entry_On_M5_Squeeze) m5sqz_txt += " — Entries BLOCKED";
                if(Exit_Trade_On_M5_Squeeze)  m5sqz_txt += " | EXIT Armed";
                m5sqz_col = clrRed;
            } else if(m5_post_squeeze_release) {
                string dir_str = (m5_sqz_release_dir == 1) ? "UP" : "DN";
                m5sqz_txt = "! " + htf1_str + " POST-SQUEEZE: CAUTION (Dir: " + dir_str + ", MSS Lvl: " + DoubleToString(m5_sqz_mss_level, _Digits) + ")" + m5_atr_str;
                if(Block_Entry_On_M5_Squeeze) m5sqz_txt += " — Entries BLOCKED";
                if(M5_Squeeze_SL_Multiplier > 0) m5sqz_txt += " | SL=" + DoubleToString(M5_Squeeze_SL_Multiplier, 1) + "xATR";
                m5sqz_col = clrOrange;
            } else {
                m5sqz_txt = htf1_str + " Squeeze: Clear" + m5_atr_str;
                m5sqz_col = clrGray;
            }
            DrawLabel("dash_m5sqz", m5sqz_txt, x, y+=gap, m5sqz_col);
        } else {
            DrawLabel("dash_m5sqz", "", x, y+=gap, clrNONE);
        }
        
        // M1 Squeeze Danger Row
        if(Use_M1_Squeeze_Filter) {
            string m1sqz_txt; color m1sqz_col;
            string m1_atr_str = (ArraySize(atr_m1_hist) > 0 && atr_m1_hist[0] > 0) ? StringFormat(" [%.2fx ATR]", (bb_up_m1_hist[0] - bb_dn_m1_hist[0]) / atr_m1_hist[0]) : "";

            if(m1_squeeze_danger) {
                string method = IsM1BarSqueezedByATR(0) ? "ATR" : "Rel";
                m1sqz_txt = "!! " + tf_str + " SQUEEZE DANGER [" + method + "]: ACTIVE" + m1_atr_str;
                if(Block_Entry_On_M1_Squeeze) m1sqz_txt += " — Entries BLOCKED";
                if(Exit_Trade_On_M1_Squeeze)  m1sqz_txt += " | EXIT Armed";
                m1sqz_col = clrRed;
            } else if(m1_post_squeeze_release) {
                string dir_str = (m1_sqz_release_dir == 1) ? "UP" : "DN";
                m1sqz_txt = "! " + tf_str + " POST-SQUEEZE: CAUTION (Dir: " + dir_str + ", MSS Lvl: " + DoubleToString(m1_sqz_mss_level, _Digits) + ")" + m1_atr_str;
                if(Block_Entry_On_M1_Squeeze) m1sqz_txt += " — Entries BLOCKED";
                if(M1_Squeeze_SL_Multiplier > 0) m1sqz_txt += " | SL=" + DoubleToString(M1_Squeeze_SL_Multiplier, 1) + "xATR";
                m1sqz_col = clrOrange;
            } else {
                m1sqz_txt = tf_str + " Squeeze: Clear" + m1_atr_str;
                m1sqz_col = clrGray;
            }
            DrawLabel("dash_m1sqz", m1sqz_txt, x, y+=gap, m1sqz_col);
        } else {
            DrawLabel("dash_m1sqz", "", x, y+=gap, clrNONE);
        }
    } else {
        DrawLabel("dash_sqz_stat", "", x, y+=gap, clrNONE);
        DrawLabel("dash_h1sqz",   "", x, y+=gap, clrNONE);
        DrawLabel("dash_m5sqz",   "", x, y+=gap, clrNONE);
        DrawLabel("dash_m1sqz",   "", x, y+=gap, clrNONE);
    }

    // --- M1 Squeeze + Major Liquidity Synergy alert ---
    if(d_m1_squeeze_lq_syn) {
        DrawLabel("dash_sqz_lq", "! " + d_m1_sqz_lq_txt, x, y+=gap, clrPurple);
    } else {
        DrawLabel("dash_sqz_lq", "", x, y+=gap, clrNONE);
    }

    // --- Speed Tracker ---
    string base_speed_txt = StringFormat("Live Speed: %.2f pts/s", rt_speed);

    if (Entry_Strategy == ENTRY_DECELERATION) {
        string speed_txt = base_speed_txt + StringFormat(" | PeakBuy: %.2f | PeakSell: %.2f", peak_buy_speed, peak_sell_speed);
        DrawLabel("dash_speed", speed_txt, x, y+=gap, clrDeepPink);
        DrawLabel("dash_speed_buy", "", x, y, clrNONE);
        DrawLabel("dash_speed_sell", "", x, y, clrNONE);
    } else if (Entry_Strategy == ENTRY_DIRECTIONAL_STOP) {
        if(Show_Dir_Stop_Details) {
            string buy_txt1 = StringFormat("[Dir BUY] PkDn: %.2f | CurDn: %.2f", peak_speed_down_for_buy, current_speed_down);
            string buy_txt2 = StringFormat("          CurUp: %.2f (Req >= %.2f)", current_speed_up, Dir_Entry_Threshold);
            DrawLabel("dash_speed_buy1", buy_txt1, x, y+=gap, clrDeepPink);
            DrawLabel("dash_speed_buy2", buy_txt2, x, y+=gap, clrDeepPink);

            string sell_txt1 = StringFormat("[Dir SELL] PkUp: %.2f | CurUp: %.2f", peak_speed_up_for_sell, current_speed_up);
            string sell_txt2 = StringFormat("           CurDn: %.2f (Req <= -%.2f)", current_speed_down, Dir_Entry_Threshold);
            DrawLabel("dash_speed_sell1", sell_txt1, x, y+=gap, clrDeepPink);
            DrawLabel("dash_speed_sell2", sell_txt2, x, y+=gap, clrDeepPink);
            
            // Hide the old single line indicators
            DrawLabel("dash_speed", "", x, y, clrNONE); 
            DrawLabel("dash_speed_buy", "", x, y, clrNONE); 
            DrawLabel("dash_speed_sell", "", x, y, clrNONE); 
        } else {
            string speed_txt = base_speed_txt + StringFormat(" | DirPeak Dn: %.2f | Up: %.2f", peak_speed_down_for_buy, peak_speed_up_for_sell);
            DrawLabel("dash_speed", speed_txt, x, y+=gap, clrDeepPink);
            DrawLabel("dash_speed_buy", "", x, y, clrNONE);
            DrawLabel("dash_speed_sell", "", x, y, clrNONE);
            DrawLabel("dash_speed_buy1", "", x, y, clrNONE); DrawLabel("dash_speed_buy2", "", x, y, clrNONE);
            DrawLabel("dash_speed_sell1", "", x, y, clrNONE); DrawLabel("dash_speed_sell2", "", x, y, clrNONE);
        }
    } else if (Entry_Strategy == ENTRY_DIR_STOP_RELATIVE) {
        long sec_elapsed = TimeCurrent() - iTime(_Symbol, _Period, 0);
        if(sec_elapsed <= 0) sec_elapsed = 1;
        double bar_age_pct = (double)sec_elapsed / (double)PeriodSeconds(_Period);
        bool use_prev = (bar_age_pct < Dir_Relative_Time_Pct);
        
        double prev_speed = ((iClose(_Symbol, _Period, 1) - iOpen(_Symbol, _Period, 1)) / _Point) / PeriodSeconds(_Period);
        double reference_speed = use_prev ? prev_speed : rt_speed;
        string ref_str = use_prev ? "PrevSpd" : "CurSpd";

        double abs_ref = MathAbs(reference_speed);
        double req_speed = MathMax(Dir_Relative_Min, abs_ref * Dir_Relative_Ratio);
        
        if(Show_Dir_Stop_Details) {
            string buy_txt1 = StringFormat("[RelDir BUY] %s: %.2f | CurDn: %.2f", ref_str, reference_speed, current_speed_down);
            string buy_txt2 = StringFormat("             CurUp: %.2f (Req >= %.2f)", current_speed_up, req_speed);
            DrawLabel("dash_speed_buy1", buy_txt1, x, y+=gap, clrDeepPink);
            DrawLabel("dash_speed_buy2", buy_txt2, x, y+=gap, clrDeepPink);

            string sell_txt1 = StringFormat("[RelDir SELL] %s: %.2f | CurUp: %.2f", ref_str, reference_speed, current_speed_up);
            string sell_txt2 = StringFormat("              CurDn: %.2f (Req <= -%.2f)", current_speed_down, req_speed);
            DrawLabel("dash_speed_sell1", sell_txt1, x, y+=gap, clrDeepPink);
            DrawLabel("dash_speed_sell2", sell_txt2, x, y+=gap, clrDeepPink);
            
            DrawLabel("dash_speed", "", x, y, clrNONE); 
            DrawLabel("dash_speed_buy", "", x, y, clrNONE); 
            DrawLabel("dash_speed_sell", "", x, y, clrNONE); 
        } else {
            string speed_txt = base_speed_txt + StringFormat(" | RelDir Req: %.2f (Ref: %s)", req_speed, ref_str);
            DrawLabel("dash_speed", speed_txt, x, y+=gap, clrDeepPink);
            DrawLabel("dash_speed_buy", "", x, y, clrNONE); DrawLabel("dash_speed_sell", "", x, y, clrNONE);
            DrawLabel("dash_speed_buy1", "", x, y, clrNONE); DrawLabel("dash_speed_buy2", "", x, y, clrNONE);
            DrawLabel("dash_speed_sell1", "", x, y, clrNONE); DrawLabel("dash_speed_sell2", "", x, y, clrNONE);
        }
    } else {
        DrawLabel("dash_speed", base_speed_txt + " (Tracking Entry Speed only)", x, y+=gap, clrDeepPink);
        DrawLabel("dash_speed_buy", "", x, y, clrNONE);
        DrawLabel("dash_speed_sell", "", x, y, clrNONE);
        DrawLabel("dash_speed_buy1", "", x, y, clrNONE); DrawLabel("dash_speed_buy2", "", x, y, clrNONE);
        DrawLabel("dash_speed_sell1", "", x, y, clrNONE); DrawLabel("dash_speed_sell2", "", x, y, clrNONE);
    }

    // --- HTF TP Upgrade Tracker ---
    if(Use_HTF_TP_Upgrade) {
        string tp_stat_txt = "Medium-Term Target (HTF TP): ";
        color tp_stat_col = clrGray;
        
        bool rsi_up_met = (d_rsi_h1_value >= RSI_Strong_Up);
        bool rsi_dn_met = (d_rsi_h1_value <= RSI_Strong_Dn);

        if(rsi_up_met && rsi_dn_met) {
            // Edge case where settings might be broken
            tp_stat_txt += "ERROR: RSI thresholds overlapping";
            tp_stat_col = clrRed;
        } else if(rsi_up_met) {
            tp_stat_txt += "ARMED for BUY (RSI >= " + DoubleToString(RSI_Strong_Up, 1) + ")";
            tp_stat_col = clrDeepSkyBlue;
        } else if(rsi_dn_met) {
            tp_stat_txt += "ARMED for SELL (RSI <= " + DoubleToString(RSI_Strong_Dn, 1) + ")";
            tp_stat_col = clrDeepSkyBlue;
        } else {
            tp_stat_txt += "WAITING Momentum (RSI between " + DoubleToString(RSI_Strong_Dn, 1) + " and " + DoubleToString(RSI_Strong_Up, 1) + ")";
            tp_stat_col = clrDarkOrange;
        }

        DrawLabel("dash_live_tp_upg", tp_stat_txt, x, y+=gap, tp_stat_col);
    } else {
        DrawLabel("dash_live_tp_upg", "Medium-Term Target (HTF TP): DISABLED", x, y+=gap, clrGray);
    }

    // ==========================================
    // SECTION 3: TRADE MANAGERS
    // ==========================================
    if(CountOpenPositions() > 0) {
        DrawLabel("dash_div3", "--- TRADE MANAGERS ---", x, y+=gap, clrBlue);

        if(Use_BOS_Exit) {
            if(bos_armed) DrawLabel("dash_exit", "BOS Exit: ARMED @ " + DoubleToString(tracked_struct_level, 5), x, y+=gap, clrPurple);
            else if(tracked_struct_level > 0) DrawLabel("dash_exit", "BOS Exit: Tracking Extreme @ " + DoubleToString(tracked_struct_level, 5), x, y+=gap, clrDarkOrange);
            else DrawLabel("dash_exit", "BOS Exit: Identifying Entry Extreme", x, y+=gap, clrDimGray);
        }

        if(Use_Momentum_Hold) {
            DrawLabel("dash_mom", "Momentum Hold: " + d_mom_status, x, y+=gap, d_pure_momentum ? clrBlue : clrDarkOrange);
        }

        if(Use_Mean_Loss_Exit) {
            // Show whether the mean exit is currently watching (position at a loss)
            bool in_trade = true;
            double cur_p = 0, open_p = 0; int ptype = -1;
            for(int i = 0; i < PositionsTotal(); i++) {
                if(PositionGetTicket(i) > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == MagicNumber) {
                    ptype   = (int)PositionGetInteger(POSITION_TYPE);
                    open_p  = PositionGetDouble(POSITION_PRICE_OPEN);
                    cur_p   = ptype == POSITION_TYPE_BUY ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
                    break;
                }
            }
            bool at_loss = (ptype == POSITION_TYPE_BUY) ? (cur_p < open_p) : (ptype == POSITION_TYPE_SELL) ? (cur_p > open_p) : false;
            string mean_txt = at_loss ? ("Mean Loss Exit: WATCHING (Mean @ " + DoubleToString(bb_base_m1[0], 5) + ")") : "Mean Loss Exit: Armed (Not At Loss)";
            color mean_col  = at_loss ? clrDarkGoldenrod : clrDimGray;
            DrawLabel("dash_mean_loss", mean_txt, x, y+=gap, mean_col);
        }

        string tp_lbl = "Target: ";
        if(active_trade_is_upgraded) {
             string tgt_name = (HTF_Upgrade_Target == TARGET_M5_MEAN) ? "M5 Mean" :
                               (HTF_Upgrade_Target == TARGET_M5_OPP_BAND) ? "M5 Opp Band" :
                               (HTF_Upgrade_Target == TARGET_H1_MEAN) ? "H1 Mean" :
                               (HTF_Upgrade_Target == TARGET_H1_OPP_BAND) ? "H1 Opp Band" : "HTF";
                               
             if(HTF_TP_Execution_Mode == HTF_TP_STATIC) tgt_name += " [STATIC]";
             else if(HTF_TP_Execution_Mode == HTF_TP_RANGE_PCT) tgt_name += StringFormat(" [%d%% RANGE]", HTF_TP_Range_Pct);

             tp_lbl += "UPGRADED HTF [" + tgt_name + "] @ " + DoubleToString(dynamic_virtual_tp, 5);
             
             // Find current price depending on pos type
             double cur_p = 0; int ptype = -1;
             for(int i = 0; i < PositionsTotal(); i++) {
                 if(PositionGetTicket(i) > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == MagicNumber) {
                     ptype   = (int)PositionGetInteger(POSITION_TYPE);
                     cur_p   = ptype == POSITION_TYPE_BUY ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
                     break;
                 }
             }
             string tp_dist_txt = "";
             if(ptype != -1) {
                 double dist_pts = 0.0;
                 if(ptype == POSITION_TYPE_BUY) dist_pts = (dynamic_virtual_tp - cur_p) / _Point;
                 else                           dist_pts = (cur_p - dynamic_virtual_tp) / _Point;
                 if(dist_pts < 0) dist_pts = 0;
                 
                 if(HTF_TP_Execution_Mode == HTF_TP_RANGE_PCT) {
                     double band_range_pts = 0.0;
                     if(HTF_Upgrade_Target == TARGET_M5_MEAN || HTF_Upgrade_Target == TARGET_M5_OPP_BAND) {
                          band_range_pts = (bb_up_m5[0] - bb_base_m5[0]) / _Point; // Mean to Band
                     } else {
                          band_range_pts = (bb_up_h1[0] - bb_base_h1[0]) / _Point; // Mean to Band
                     }
                     double dist_pct = 0.0;
                     if(band_range_pts > 0) dist_pct = (dist_pts / band_range_pts) * 100.0;
                     tp_dist_txt = StringFormat("       -> (Dist to TP: %.1f%% of Range)", dist_pct);
                 } else {
                     tp_dist_txt = StringFormat("       -> (Dist to TP: %.1f pts)", dist_pts);
                 }
             }
             
             DrawLabel("dash_tp", tp_lbl, x, y+=gap, clrDeepSkyBlue);
             if(tp_dist_txt != "") DrawLabel("dash_tp_dist", tp_dist_txt, x, y+=gap, clrDeepSkyBlue);
             else DrawLabel("dash_tp_dist", "", x, y, clrNONE);
        } else {
             string tgt_name = (TP_Type == TP_HALF_MEAN) ? "M1 Half Mean" : "M1 Mean";
             tp_lbl += "Standard [" + tgt_name + "] @ " + DoubleToString(dynamic_virtual_tp, 5);
             DrawLabel("dash_tp", tp_lbl, x, y+=gap, clrDarkGray);
             DrawLabel("dash_tp_dist", "", x, y, clrNONE);
        }

    } else {
        DrawLabel("dash_div3", "", x, y+=gap, clrNONE); DrawLabel("dash_exit", "", x, y+=gap, clrNONE); DrawLabel("dash_mom", "", x, y+=gap, clrNONE); DrawLabel("dash_mean_loss", "", x, y+=gap, clrNONE); DrawLabel("dash_tp", "", x, y+=gap, clrNONE); DrawLabel("dash_tp_dist", "", x, y, clrNONE);
    }

    // --- Cleanup random orphans ---
    int objs = ObjectsTotal(0, 0, OBJ_LABEL);
    for(int i=objs-1; i>=0; i--) {
        string n = ObjectName(0, i, 0, OBJ_LABEL);
        if(StringFind(n, "dash_") != 0 && n == "Label") {
            ObjectDelete(0, n);
        }
    }
}

void DrawLabel(string name, string text, int x, int y, color col) {
    if(ObjectFind(0, name) < 0) {
        ObjectCreate(0, name, OBJ_LABEL, 0, 0, 0); ObjectSetInteger(0, name, OBJPROP_CORNER, CORNER_RIGHT_UPPER); ObjectSetInteger(0, name, OBJPROP_ANCHOR, ANCHOR_RIGHT_UPPER); ObjectSetInteger(0, name, OBJPROP_FONTSIZE, 10); ObjectSetString(0, name, OBJPROP_FONT, "Courier New");
    }
    ObjectSetString(0, name, OBJPROP_TEXT, text); ObjectSetInteger(0, name, OBJPROP_COLOR, col); ObjectSetInteger(0, name, OBJPROP_XDISTANCE, x); ObjectSetInteger(0, name, OBJPROP_YDISTANCE, y);
}

//+------------------------------------------------------------------+
//+------------------------------------------------------------------+
//| Unretested Fractal Filter (Evaluated in Dashboard States)        |
//| Fix: The retest must be done by comparing the internal ranges    |
//|      of the two most recent structural swings. If the recent     |
//|      swing range touches the previous swing range, it is considered|
//|      retested (momentum is consolidating). If there is a clean     |
//|      gap between them, momentum is too strong (un-retested).     |
//| Fix 2: Dynamically accumulate fractals until the swing range     |
//|      reaches a minimum size (ATR based) to filter out flat noise.|
//+------------------------------------------------------------------+
void EvaluateUnretestedFractals() {
    d_retest_buy_ok = true;     
    d_retest_sell_ok = true;
    d_ur_recent_top = 0; d_ur_recent_bot = 0; d_ur_recent_top_t = 0; d_ur_recent_bot_t = 0;
    d_ur_prev_top = 0; d_ur_prev_bot = 0; d_ur_prev_top_t = 0; d_ur_prev_bot_t = 0;
    
    if(!Use_Unretested_Fractal_Filter) return;
    if(ArraySize(atr_m1) == 0 || atr_m1[0] <= 0) return;
    
    int limit = 400; // Increased limit because we may need to scan further to build large ranges
    double min_range_sz = atr_m1[0] * Unretested_Min_ATR_Range;
    
    double r_top[2] = {0, 0};
    double r_bot[2] = {0, 0};
    datetime r_top_t[2] = {0, 0};
    datetime r_bot_t[2] = {0, 0};
    int r_count = 0;
    
    double cur_top = 0, cur_bot = 0;
    datetime cur_top_t = 0, cur_bot_t = 0;
    bool has_top = false, has_bot = false;

    // Dynamically build minimum-size structural swings
    for(int i=2; i<limit && r_count < 2; i++) {
        if(IsTopFractal(i)) {
            double h = iHigh(_Symbol, _Period, i);
            if(!has_top || h > cur_top) {
                cur_top = h; cur_top_t = iTime(_Symbol, _Period, i); has_top = true;
            }
        }
        if(IsBottomFractal(i)) {
            double l = iLow(_Symbol, _Period, i);
            if(!has_bot || l < cur_bot) {
                cur_bot = l; cur_bot_t = iTime(_Symbol, _Period, i); has_bot = true;
            }
        }
        
        if(has_top && has_bot) {
            // Did this expanding range finally reach our minimum structural size requirement?
            if((cur_top - cur_bot) >= min_range_sz) {
                r_top[r_count] = cur_top; r_top_t[r_count] = cur_top_t;
                r_bot[r_count] = cur_bot; r_bot_t[r_count] = cur_bot_t;
                r_count++;
                
                // Reset to begin looking for the NEXT separate swing range backwards
                has_top = false; has_bot = false; cur_top = 0; cur_bot = 0;
            }
        }
    }
    
    if(r_count == 2) {
        d_ur_recent_top = r_top[0]; d_ur_recent_top_t = r_top_t[0];
        d_ur_recent_bot = r_bot[0]; d_ur_recent_bot_t = r_bot_t[0];
        
        d_ur_prev_top = r_top[1];   d_ur_prev_top_t = r_top_t[1];
        d_ur_prev_bot = r_bot[1];   d_ur_prev_bot_t = r_bot_t[1];
        
        // Two ranges overlap if: (r1_max >= r2_min) AND (r1_min <= r2_max)
        bool is_overlapping = (d_ur_recent_top >= d_ur_prev_bot && d_ur_recent_bot <= d_ur_prev_top);
        
        if(!is_overlapping) {
            // There is a GAP between the recent swing and the previous swing.
            if(d_ur_recent_top < d_ur_prev_bot) {
                // Downtrend Gap -> Strong downward momentum -> Block Buys
                d_retest_buy_ok = false;
            }
            if(d_ur_recent_bot > d_ur_prev_top) {
                // Uptrend Gap -> Strong upward momentum -> Block Sells
                d_retest_sell_ok = false;
            }
        }
    }
}

//+------------------------------------------------------------------+
//| ENTRY LOGIC                                                      |
//+------------------------------------------------------------------+
void CheckEntry() {
    datetime current_bar_time = iTime(_Symbol, _Period, 0);
    if(last_trade_bar == current_bar_time) return;

    double ask = SymbolInfoDouble(_Symbol, SYMBOL_ASK); double bid = SymbolInfoDouble(_Symbol, SYMBOL_BID);

    // --- HTF Squeeze Entry Guard ---
    if(Block_Entry_On_H1_Squeeze && (h1_squeeze_danger || h1_post_squeeze_release)) {
        peak_buy_speed = 0; peak_sell_speed = 0;
        return;
    }
    if(Block_Entry_On_M5_Squeeze && (m5_squeeze_danger || m5_post_squeeze_release)) {
        peak_buy_speed = 0; peak_sell_speed = 0;
        return;
    }
    if(Block_Entry_On_M1_Squeeze && (m1_squeeze_danger || m1_post_squeeze_release)) {
        peak_buy_speed = 0; peak_sell_speed = 0;
        return;
    }

    // Determine effective SL multiplier
    double eff_sl_mult = SL_ATR_Multiplier;
    if(Use_Squeeze_Filter) {
        if(h1_post_squeeze_release && H1_Squeeze_SL_Multiplier > 0) {
            eff_sl_mult = MathMin(eff_sl_mult, H1_Squeeze_SL_Multiplier);
        }
        if(m5_post_squeeze_release && M5_Squeeze_SL_Multiplier > 0) {
            eff_sl_mult = MathMin(eff_sl_mult, M5_Squeeze_SL_Multiplier);
        }
        if(m1_post_squeeze_release && M1_Squeeze_SL_Multiplier > 0) {
            eff_sl_mult = MathMin(eff_sl_mult, M1_Squeeze_SL_Multiplier);
        }
    }

    // Checklist implementation
    bool is_eod = IsEndOfDayRestricted();
    bool is_hour_blocked = IsTradingHourBlocked();
    
    bool effective_ranging_h1 = (d_is_ranging && ADX_Range_Bypass_H1) || (M1_Mom_Bypass_HTF && d_m1_is_ranging);
    bool effective_ranging_m5 = (d_is_ranging && ADX_Range_Bypass_M5) || (M1_Mom_Bypass_MTF && d_m1_is_ranging);

    bool h1_buy_ok  = effective_ranging_h1 ? true : d_h1_buy;
    bool h1_sell_ok = effective_ranging_h1 ? true : d_h1_sell;
    bool m5_buy_ok  = effective_ranging_m5 ? true : d_m5_buy;
    bool m5_sell_ok = effective_ranging_m5 ? true : d_m5_sell;

    bool fib50_buy_ok = Use_Fib50_Filter ? (bid < d_fib_active_buy) : true;
    bool fib50_sell_ok = Use_Fib50_Filter ? (ask > d_fib_active_sell) : true;
    
    bool valid_buy_setup = (!d_is_news_time && !is_eod && !is_hour_blocked && h1_buy_ok && m5_buy_ok && fib50_buy_ok && d_clear_buy && d_sweep_buy && d_extreme_buy && d_retest_buy_ok);
    bool valid_sell_setup = (!d_is_news_time && !is_eod && !is_hour_blocked && h1_sell_ok && m5_sell_ok && fib50_sell_ok && d_clear_sell && d_sweep_sell && d_extreme_sell && d_retest_sell_ok);

    if(Use_M1_Momentum) {
        if(d_m1_mom_trend == 1) { // Up momentum, block shorts
            valid_sell_setup = false;
        } else if(d_m1_mom_trend == -1) { // Down momentum, block longs
            valid_buy_setup = false;
        } else if(!d_m1_is_ranging && !M1_Mom_Allow_Neutral) { 
            // It's in the neutral zone (not trending, not strictly ranging).
            // If we don't allow neutral, we block BOTH buy and sell in this intermediate state.
            valid_buy_setup = false;
            valid_sell_setup = false;
        }
    }

    // --- MOMENTUM HOLD ENTRY GATE ---
    // If Only_Trade_When_MomHold is enabled, only take trades whose entry bar cluster
    // qualifies as a spike (same condition that makes Use_Momentum_Hold target the opposite band).
    if(Only_Trade_When_MomHold && Use_Momentum_Hold) {
        // Evaluate spike on bar 0 (the entry bar being considered)
        bool entry_qualifies_as_spike = true;
        if(Require_Spike_Entry) {
            double max_h = 0.0;
            double min_l = 999999.0;
            for(int k = 0; k < Spike_Lookback_Bars; k++) {
                double h = iHigh(_Symbol, _Period, k);
                double l = iLow(_Symbol, _Period, k);
                if(h > max_h) max_h = h;
                if(l < min_l) min_l = l;
            }
            double setup_range = max_h - min_l;
            int safe_shift = Spike_ATR_Shift;
            if(safe_shift >= ArraySize(atr_m1)) safe_shift = ArraySize(atr_m1) - 1;
            if(atr_m1[safe_shift] > 0 && setup_range < (atr_m1[safe_shift] * Spike_ATR_Multiplier)) {
                entry_qualifies_as_spike = false;
            }
        }
        if(!entry_qualifies_as_spike) {
            valid_buy_setup  = false;
            valid_sell_setup = false;
        }
    }

    // Track Peak Speeds LIVE as price approaches entries
    if(Entry_Strategy == ENTRY_DECELERATION) {
        if(d_h1_buy || d_m5_buy || d_extreme_buy || d_sweep_buy) {
            if(current_speed > peak_buy_speed) peak_buy_speed = current_speed;
        } else {
            peak_buy_speed = 0;
        }

        if(d_h1_sell || d_m5_sell || d_extreme_sell || d_sweep_sell) {
            if(current_speed > peak_sell_speed) peak_sell_speed = current_speed;
        } else {
            peak_sell_speed = 0;
        }
    } else if(Entry_Strategy == ENTRY_DIRECTIONAL_STOP) {
        // For buys, we track the most negative (fastest downward) speed
        if(d_h1_buy || d_m5_buy || d_extreme_buy || d_sweep_buy) {
            if(current_speed_down < peak_speed_down_for_buy) peak_speed_down_for_buy = current_speed_down;
        } else {
            peak_speed_down_for_buy = 0;
        }

        // For sells, we track the most positive (fastest upward) speed
        if(d_h1_sell || d_m5_sell || d_extreme_sell || d_sweep_sell) {
            if(current_speed_up > peak_speed_up_for_sell) peak_speed_up_for_sell = current_speed_up;
        } else {
            peak_speed_up_for_sell = 0;
        }
    }

    // --- Live Speed Guardrails for Entry ---
    double open_p = iOpen(_Symbol, _Period, 0);
    double close_p = iClose(_Symbol, _Period, 0); 
    double pips_diff = (close_p - open_p) / _Point; 
    long time_sec = TimeCurrent() - current_bar_time;
    if(time_sec <= 0) time_sec = 1;
    double real_time_speed = pips_diff / (double)time_sec;

    double open_p_prev = iOpen(_Symbol, _Period, 1);
    double close_p_prev = iClose(_Symbol, _Period, 1);
    double prev_speed = ((close_p_prev - open_p_prev) / _Point) / PeriodSeconds(_Period);

    if(valid_buy_setup) {
        if(!IsSpeedAllowed(real_time_speed, AllowedSpeedRanges)) {
            valid_buy_setup = false; // Block if out of bounds
        }
    }
    if(valid_sell_setup) {
        if(!IsSpeedAllowed(real_time_speed, AllowedSpeedRanges)) {
            valid_sell_setup = false; // Block if out of bounds
        }
    }

    if(valid_buy_setup) {
        if(Entry_Strategy == ENTRY_IMMEDIATE) { 
            ExecuteBuy(ask, bid, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult); 
        } 
        else if(Entry_Strategy == ENTRY_DECELERATION) { 
            if(peak_buy_speed > 0 && current_speed <= (peak_buy_speed * (1.0 - Speed_Drop_Pct))) { 
                ExecuteBuy(ask, bid, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult); 
                peak_buy_speed = 0; 
            } 
        }
        else if(Entry_Strategy == ENTRY_DIRECTIONAL_STOP) {
            // Downward momentum peaked (negative values), market stopped (speed >= 0), and ticked up above Dir_Entry_Threshold
            if(peak_speed_down_for_buy < 0 && current_speed_down >= 0 && current_speed_up >= Dir_Entry_Threshold) {
                ExecuteBuy(ask, bid, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult);
                peak_speed_down_for_buy = 0;
            }
        }
        else if(Entry_Strategy == ENTRY_DIR_STOP_RELATIVE) {
            double bar_age_pct = (double)time_sec / (double)PeriodSeconds(_Period);
            double reference_speed = (bar_age_pct < Dir_Relative_Time_Pct) ? prev_speed : real_time_speed;
            double req_speed = MathMax(Dir_Relative_Min, MathAbs(reference_speed) * Dir_Relative_Ratio);
            if(current_speed_down >= 0 && current_speed_up >= req_speed) {
                ExecuteBuy(ask, bid, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult);
            }
        }
    } else if (Entry_Strategy == ENTRY_DECELERATION) { 
        peak_buy_speed = 0; 
    } else if (Entry_Strategy == ENTRY_DIRECTIONAL_STOP) {
        peak_speed_down_for_buy = 0;
    }

    if(valid_sell_setup) {
        if(Entry_Strategy == ENTRY_IMMEDIATE) { 
            ExecuteSell(bid, ask, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult); 
        } 
        else if(Entry_Strategy == ENTRY_DECELERATION) { 
            if(peak_sell_speed > 0 && current_speed <= (peak_sell_speed * (1.0 - Speed_Drop_Pct))) { 
                ExecuteSell(bid, ask, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult); 
                peak_sell_speed = 0; 
            } 
        }
        else if(Entry_Strategy == ENTRY_DIRECTIONAL_STOP) {
            // Upward momentum peaked, market stopped (speed <= 0), and ticked down above Dir_Entry_Threshold (negative tick)
            if(peak_speed_up_for_sell > 0 && current_speed_up <= 0 && current_speed_down <= -Dir_Entry_Threshold) {
                ExecuteSell(bid, ask, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult);
                peak_speed_up_for_sell = 0;
            }
        }
        else if(Entry_Strategy == ENTRY_DIR_STOP_RELATIVE) {
            double bar_age_pct = (double)time_sec / (double)PeriodSeconds(_Period);
            double reference_speed = (bar_age_pct < Dir_Relative_Time_Pct) ? prev_speed : real_time_speed;
            double req_speed = MathMax(Dir_Relative_Min, MathAbs(reference_speed) * Dir_Relative_Ratio);
            if(current_speed_up <= 0 && current_speed_down <= -req_speed) {
                ExecuteSell(bid, ask, current_bar_time, real_time_speed, prev_speed, time_sec, eff_sl_mult);
            }
        }
    } else if (Entry_Strategy == ENTRY_DECELERATION) { 
        peak_sell_speed = 0; 
    } else if (Entry_Strategy == ENTRY_DIRECTIONAL_STOP) {
        peak_speed_up_for_sell = 0;
    }
}

double CalcLotSize(double sl_price_distance) {
    double lot = LotSize;
    double equity       = AccountInfoDouble(ACCOUNT_EQUITY);
    double risk_amount  = equity * (Risk_Percent / 100.0);
    double tick_size    = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_SIZE);
    double tick_value   = SymbolInfoDouble(_Symbol, SYMBOL_TRADE_TICK_VALUE);
    double lot_step     = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
    double min_lot      = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
    double max_lot      = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MAX);
    if(tick_size <= 0 || tick_value <= 0) return lot; // Fallback to LotSize (but clamped below)
    
    if(Use_Auto_Lot) {
        double ticks_in_sl  = sl_price_distance / tick_size;
        lot = risk_amount / (ticks_in_sl * tick_value);
    } 

    // --- Strict Fixed Lot Safety Control ---
    double max_lot_allowed = Use_Auto_Lot ? max_lot : LotSize;
    double current_open_lots = TotalOpenLots();
    double available_lots = max_lot_allowed - current_open_lots;
    
    if(available_lots < min_lot) {
        PrintFormat("SAFETY BAIL: Max lots reached. Allowed: %.2f | Open: %.2f", max_lot_allowed, current_open_lots);
        return 0; // abort trade
    }
    
    // Clamp the requested lot size so it doesn't push us over the limit
    if(lot > available_lots) lot = available_lots;

    lot = MathFloor(lot / lot_step) * lot_step;    // normalise to lot step
    lot = MathMax(min_lot, MathMin(max_lot, lot)); // clamp to broker absolute limits
    return lot;
}
void ExecuteBuy(double ask, double bid, datetime bar_time, double live_speed, double prev_speed, long time_sec, double sl_mult = -1) {
    if(sl_mult < 0) sl_mult = SL_ATR_Multiplier;
    double sl_dist = sl_mult * atr_m1[0];
    double sl      = bid - sl_dist;
    double lots    = CalcLotSize(sl_dist);
    
    string cmt = StringFormat("B|%.2f|%.2f|%d", live_speed, prev_speed, time_sec);
    
    bool trade_exec = trade.Buy(lots, _Symbol, ask, sl, 0, cmt);
    if(trade_exec) {
        double atr_val = 0; if (ArraySize(atr_m1) > 0) atr_val = atr_m1[0];
        
        // --- Calculate Slippage & Update Comment ---
        double filled_price = trade.ResultPrice();
        ulong ticket = trade.ResultOrder();
        if(ticket == 0) ticket = trade.ResultDeal(); // fallback
        
        int slippage_points = 0;
        if(filled_price > 0 && ask > 0) {
            slippage_points = (int)MathRound((filled_price - ask) / _Point); 
        }
        string new_cmt = cmt + StringFormat("|Slp:%d", slippage_points);
        // PositionModify doesn't allow comment changes directly in all broker configs, 
        // but we can Print it and try to modify if supported.
        trade.PositionModify(ticket, sl, 0); 
        // Note: MT5 doesn't officially support changing a position comment after open via MQL5,
        // so we must trust the terminal or log it aggressively here.
        PrintFormat("BUY ENTRY! Req: %.5f | Fill: %.5f | SlipPts: %d | SL: %.5f | Speed: %.2f | ATR: %.5f", ask, filled_price, slippage_points, sl, peak_buy_speed, atr_val);
        
        last_trade_bar = bar_time;
        InitDynamicTP(filled_price, true);
    } else {
        last_entry_try_time = TimeCurrent();
        PrintFormat("BUY ENTRY FAILED! Req: %.5f | Retcode: %d - %s", ask, trade.ResultRetcode(), trade.ResultRetcodeDescription());
    }
}
void ExecuteSell(double bid, double ask, datetime bar_time, double live_speed, double prev_speed, long time_sec, double sl_mult = -1) {
    if(sl_mult < 0) sl_mult = SL_ATR_Multiplier;
    double atr_val = 0; if (ArraySize(atr_m1) > 0) atr_val = atr_m1[0];
    double sl = bid + (atr_val * sl_mult);
    
    // Convert to exact pip values for the broker
    sl = NormalizeDouble(sl, _Digits);

    double lots = CalcLotSize(MathAbs(bid - sl));
    if (lots <= 0) { Print("Lot size 0, aborting trade."); return; }
    
    string cmt = StringFormat("S|%.2f|%.2f|%d", live_speed, prev_speed, time_sec);

    bool trade_exec = trade.Sell(lots, _Symbol, bid, sl, 0, cmt);
    if(trade_exec) {
        // --- Calculate Slippage & Update Comment ---
        double filled_price = trade.ResultPrice();
        ulong ticket = trade.ResultOrder();
        if(ticket == 0) ticket = trade.ResultDeal();
        
        int slippage_points = 0;
        if(filled_price > 0 && bid > 0) {
            slippage_points = (int)MathRound((bid - filled_price) / _Point); 
        }
        string new_cmt = cmt + StringFormat("|Slp:%d", slippage_points);
        trade.PositionModify(ticket, sl, 0);
        
        PrintFormat("SELL ENTRY! Req: %.5f | Fill: %.5f | SlipPts: %d | SL: %.5f | Speed: %.2f | ATR: %.5f", bid, filled_price, slippage_points, sl, peak_sell_speed, atr_val);
        
        last_trade_bar = bar_time;
        InitDynamicTP(filled_price, false);
    } else {
        last_entry_try_time = TimeCurrent();
        PrintFormat("SELL ENTRY FAILED! Req: %.5f | Retcode: %d - %s", bid, trade.ResultRetcode(), trade.ResultRetcodeDescription());
    }
}

//+------------------------------------------------------------------+
//| Aggressive Position Closing                                      |
//+------------------------------------------------------------------+
bool ClosePositionAggressive(ulong ticket, double lots_to_close = -1) {
    int max_retries = 10;
    int retry_count = 0;
    bool success = false;
    
    while(retry_count < max_retries && !success) {
        if(lots_to_close > 0) {
            success = trade.PositionClosePartial(ticket, lots_to_close);
        } else {
            success = trade.PositionClose(ticket);
        }
        
        if(success) {
            return true;
        } else {
            PrintFormat("Close Error [Attempt %d]: %d - %s", retry_count + 1, trade.ResultRetcode(), trade.ResultRetcodeDescription());
            retry_count++;
            Sleep(100); // 100ms delay between aggressive retries
        }
    }
    return false;
}

//+------------------------------------------------------------------+
//| REAL-TIME Cluster-Aware & Deep Sweep Logic                       |
//+------------------------------------------------------------------+
bool CheckLiquiditySweepRealTime(bool isBuy, double current_price, string &out_type, double &out_price, bool disable_sweep_req = false) {
    double cluster_dist = atr_m1[0] * ClusterToleranceATR; bool valid_sweep_found = false;
    if(isBuy) {
        for(int i = 0; i < ArraySize(active_supports); i++) {
            bool apply_deep = active_supports[i].deep_sweep && !disable_sweep_req;
            bool apply_normal = Use_Normal_Sweep && !apply_deep && !disable_sweep_req;
            
            double raw_sup_price = active_supports[i].price; 
            double trigger_price = raw_sup_price; 
            if(apply_deep) trigger_price -= (atr_m1[0] * DeepSweep_ATR);
            else if(apply_normal) trigger_price -= (atr_m1[0] * NormalSweep_ATR);
            
            if(current_price <= trigger_price) {
                bool lower_cluster_unswept = false;
                for(int j = 0; j < ArraySize(active_supports); j++) {
                    double other_sup = active_supports[j].price;
                    bool apply_deep_other = active_supports[j].deep_sweep && !disable_sweep_req;
                    bool apply_normal_other = Use_Normal_Sweep && !apply_deep_other && !disable_sweep_req;
                    
                    if(other_sup < raw_sup_price && (raw_sup_price - other_sup) <= cluster_dist) { 
                        double other_trigger = other_sup; 
                        if(apply_deep_other) other_trigger -= (atr_m1[0] * DeepSweep_ATR);
                        else if(apply_normal_other) other_trigger -= (atr_m1[0] * NormalSweep_ATR);
                        
                        if(current_price > other_trigger) { lower_cluster_unswept = true; break; } 
                    }
                }
                if(!lower_cluster_unswept) { valid_sweep_found = true; out_type = active_supports[i].type; out_price = active_supports[i].price; break; }
            }
        }
    } else {
        for(int i = 0; i < ArraySize(active_resistances); i++) {
            bool apply_deep = active_resistances[i].deep_sweep && !disable_sweep_req;
            bool apply_normal = Use_Normal_Sweep && !apply_deep && !disable_sweep_req;
            
            double raw_res_price = active_resistances[i].price; 
            double trigger_price = raw_res_price; 
            if(apply_deep) trigger_price += (atr_m1[0] * DeepSweep_ATR);
            else if(apply_normal) trigger_price += (atr_m1[0] * NormalSweep_ATR);
            
            if(current_price >= trigger_price) {
                bool higher_cluster_unswept = false;
                for(int j = 0; j < ArraySize(active_resistances); j++) {
                    double other_res = active_resistances[j].price;
                    bool apply_deep_other = active_resistances[j].deep_sweep && !disable_sweep_req;
                    bool apply_normal_other = Use_Normal_Sweep && !apply_deep_other && !disable_sweep_req;
                    
                    if(other_res > raw_res_price && (other_res - raw_res_price) <= cluster_dist) { 
                        double other_trigger = other_res; 
                        if(apply_deep_other) other_trigger += (atr_m1[0] * DeepSweep_ATR); 
                        else if(apply_normal_other) other_trigger += (atr_m1[0] * NormalSweep_ATR);
                        
                        if(current_price < other_trigger) { higher_cluster_unswept = true; break; } 
                    }
                }
                if(!higher_cluster_unswept) { valid_sweep_found = true; out_type = active_resistances[i].type; out_price = active_resistances[i].price; break; }
            }
        }
    }
    return valid_sweep_found;
}

//--- LIQUIDITY SCANNER ---
void ScanInternalLiquidity() {
    ArrayResize(active_supports, 0); ArrayResize(active_resistances, 0); double eq_tolerance = atr_m1[0] * EqualThresholdATR; STempLiquidity t_sup[], t_res[];
    for(int i = SwingLookback; i >= 2; i--) { 
        if(IsBottomFractal(i)) { int s = ArraySize(t_sup); ArrayResize(t_sup, s+1); t_sup[s].price = iLow(_Symbol, _Period, i); t_sup[s].time = iTime(_Symbol, _Period, i); t_sup[s].bar_index = i; t_sup[s].is_major = IsMajorBottom(i, MajorSwingCandles); t_sup[s].is_eq = false; t_sup[s].break_idx = 0; t_sup[s].flip_broken = false; t_sup[s].req_deep = Use_Deep_Sweep ? t_sup[s].is_major : false; }
        if(IsTopFractal(i)) { int s = ArraySize(t_res); ArrayResize(t_res, s+1); t_res[s].price = iHigh(_Symbol, _Period, i); t_res[s].time = iTime(_Symbol, _Period, i); t_res[s].bar_index = i; t_res[s].is_major = IsMajorTop(i, MajorSwingCandles); t_res[s].is_eq = false; t_res[s].break_idx = 0; t_res[s].flip_broken = false; t_res[s].req_deep = Use_Deep_Sweep ? t_res[s].is_major : false; }
    }
    for(int i=0; i<ArraySize(t_sup); i++) { for(int j=i+1; j<ArraySize(t_sup); j++) { if(MathAbs(t_sup[i].price - t_sup[j].price) <= eq_tolerance) { t_sup[i].is_eq = true; t_sup[j].is_eq = true; double min_p = MathMin(t_sup[i].price, t_sup[j].price); t_sup[i].price = min_p; t_sup[j].price = min_p; if(MathAbs(t_sup[i].bar_index - t_sup[j].bar_index) >= DeepSweep_MinBars) { if(Use_Deep_Sweep) { t_sup[i].req_deep = true; t_sup[j].req_deep = true; } } } } }
    for(int i=0; i<ArraySize(t_res); i++) { for(int j=i+1; j<ArraySize(t_res); j++) { if(MathAbs(t_res[i].price - t_res[j].price) <= eq_tolerance) { t_res[i].is_eq = true; t_res[j].is_eq = true; double max_p = MathMax(t_res[i].price, t_res[j].price); t_res[i].price = max_p; t_res[j].price = max_p; if(MathAbs(t_res[i].bar_index - t_res[j].bar_index) >= DeepSweep_MinBars) { if(Use_Deep_Sweep) { t_res[i].req_deep = true; t_res[j].req_deep = true; } } } } }
    for(int i=0; i<ArraySize(t_sup); i++) { for(int j = t_sup[i].bar_index - 1; j >= 1; j--) { if(t_sup[i].break_idx == 0 && iClose(_Symbol, _Period, j) < t_sup[i].price) { t_sup[i].break_idx = j; } else if(t_sup[i].break_idx > 0 && iClose(_Symbol, _Period, j) > t_sup[i].price) { t_sup[i].flip_broken = true; break; } } }
    for(int i=0; i<ArraySize(t_res); i++) { for(int j = t_res[i].bar_index - 1; j >= 1; j--) { if(t_res[i].break_idx == 0 && iClose(_Symbol, _Period, j) > t_res[i].price) { t_res[i].break_idx = j; } else if(t_res[i].break_idx > 0 && iClose(_Symbol, _Period, j) < t_res[i].price) { t_res[i].flip_broken = true; break; } } }
    for(int i=0; i<ArraySize(t_sup); i++) { if(t_sup[i].break_idx == 0) { AddToSupports(t_sup[i].price, t_sup[i].time, t_sup[i].is_eq ? "EQL" : "Support", t_sup[i].req_deep); } else if(!t_sup[i].flip_broken && (t_sup[i].is_major || t_sup[i].is_eq)) { AddToResistances(t_sup[i].price, t_sup[i].time, "Flip Sup->Res", t_sup[i].req_deep); } }
    for(int i=0; i<ArraySize(t_res); i++) { if(t_res[i].break_idx == 0) { AddToResistances(t_res[i].price, t_res[i].time, t_res[i].is_eq ? "EQH" : "Resistance", t_res[i].req_deep); } else if(!t_res[i].flip_broken && (t_res[i].is_major || t_res[i].is_eq)) { AddToSupports(t_res[i].price, t_res[i].time, "Flip Res->Sup", t_res[i].req_deep); } }
}
void AddToSupports(double price, datetime time, string type, bool deep) { double eq_tol = atr_m1[0] * EqualThresholdATR; for(int i=0; i<ArraySize(active_supports); i++) { if(MathAbs(active_supports[i].price - price) <= eq_tol) { if(price < active_supports[i].price) active_supports[i].price = price; if(type == "EQL") active_supports[i].type = "EQL"; else if(type == "Flip Res->Sup" && active_supports[i].type != "EQL") active_supports[i].type = "Flip Res->Sup"; active_supports[i].deep_sweep = (active_supports[i].deep_sweep || deep); return; } } int s = ArraySize(active_supports); ArrayResize(active_supports, s+1); active_supports[s].price = price; active_supports[s].time = time; active_supports[s].type = type; active_supports[s].deep_sweep = deep; }
void AddToResistances(double price, datetime time, string type, bool deep) { double eq_tol = atr_m1[0] * EqualThresholdATR; for(int i=0; i<ArraySize(active_resistances); i++) { if(MathAbs(active_resistances[i].price - price) <= eq_tol) { if(price > active_resistances[i].price) active_resistances[i].price = price; if(type == "EQH") active_resistances[i].type = "EQH"; else if(type == "Flip Sup->Res" && active_resistances[i].type != "EQH") active_resistances[i].type = "Flip Sup->Res"; active_resistances[i].deep_sweep = (active_resistances[i].deep_sweep || deep); return; } } int s = ArraySize(active_resistances); ArrayResize(active_resistances, s+1); active_resistances[s].price = price; active_resistances[s].time = time; active_resistances[s].type = type; active_resistances[s].deep_sweep = deep; }
bool IsBottomFractal(int index) { double low = iLow(_Symbol, _Period, index); return (low < iLow(_Symbol, _Period, index-1) && low <= iLow(_Symbol, _Period, index-2) && low <= iLow(_Symbol, _Period, index+1) && low <= iLow(_Symbol, _Period, index+2)); }
bool IsTopFractal(int index) { double high = iHigh(_Symbol, _Period, index); return (high > iHigh(_Symbol, _Period, index-1) && high >= iHigh(_Symbol, _Period, index-2) && high >= iHigh(_Symbol, _Period, index+1) && high >= iHigh(_Symbol, _Period, index+2)); }
bool IsMajorBottom(int index, int distance) { double low = iLow(_Symbol, _Period, index); for(int i=1; i<=distance; i++) { if(index-i >= 0 && iLow(_Symbol, _Period, index-i) < low) return false; if(iLow(_Symbol, _Period, index+i) < low) return false; } return true; }
bool IsMajorTop(int index, int distance) { double high = iHigh(_Symbol, _Period, index); for(int i=1; i<=distance; i++) { if(index-i >= 0 && iHigh(_Symbol, _Period, index-i) > high) return false; if(iHigh(_Symbol, _Period, index+i) > high) return false; } return true; }

//+------------------------------------------------------------------+
//| RSI-Adaptive H1 Zone Visual Lines                                |
//|                                                                  |
//| Draws two horizontal ray lines on the chart showing exactly      |
//| where price must be for the EA to consider a valid H1 zone:      |
//|   Green dashed  = Buy  zone ceiling  (price must be ≤ this)      |
//|   Red   dashed  = Sell zone floor    (price must be ≥ this)      |
//|                                                                  |
//| A label beside each line shows the zone %, RSI value, and the   |
//| effective price. Lines are hidden when the feature is disabled.  |
//+------------------------------------------------------------------+
void DrawRSIZoneLines() {
    string buy_line  = "vis_rsi_buy_line";
    string sell_line = "vis_rsi_sell_line";
    string buy_txt   = "vis_rsi_buy_txt";
    string sell_txt  = "vis_rsi_sell_txt";

    // Always clean up if feature is disabled
    if(!Use_RSI_Zone_Adapt) {
        ObjectDelete(0, buy_line);
        ObjectDelete(0, sell_line);
        ObjectDelete(0, buy_txt);
        ObjectDelete(0, sell_txt);
        return;
    }

    double h1_range      = bb_up_h1[0] - bb_dn_h1[0];
    double buy_ceiling   = bb_dn_h1[0]  + (h1_range * d_h1_zone_buy_pct);  // Price must be <= this for buy
    double sell_floor    = bb_up_h1[0]  - (h1_range * d_h1_zone_sel_pct);  // Price must be >= this for sell

    // --- Colours: full brightness when zone is wide (weak RSI), dimmer when tight ---
    color buy_col  = (d_h1_zone_buy_pct >= H1_RSI_Max_Zone_Pct * 0.9) ? clrLime        // Max expansion
                   : (d_h1_zone_buy_pct <= H1_Extreme_Zone_Pct  * 1.1) ? clrForestGreen // Tight / base
                   : clrMediumSeaGreen;                                                  // Interpolating

    color sell_col = (d_h1_zone_sel_pct >= H1_RSI_Max_Zone_Pct * 0.9) ? clrRed
                   : (d_h1_zone_sel_pct <= H1_Extreme_Zone_Pct  * 1.1) ? clrFireBrick
                   : clrIndianRed;

    // --- Line style: solid when at max expansion, dashed otherwise ---
    int buy_style  = (d_h1_zone_buy_pct >= H1_RSI_Max_Zone_Pct * 0.9) ? STYLE_SOLID : STYLE_DASH;
    int sell_style = (d_h1_zone_sel_pct >= H1_RSI_Max_Zone_Pct * 0.9) ? STYLE_SOLID : STYLE_DASH;

    // --- Buy ceiling line ---
    if(ObjectFind(0, buy_line) < 0)
        ObjectCreate(0, buy_line, OBJ_HLINE, 0, 0, buy_ceiling);
    ObjectSetDouble(0,  buy_line, OBJPROP_PRICE,  buy_ceiling);
    ObjectSetInteger(0, buy_line, OBJPROP_COLOR,  buy_col);
    ObjectSetInteger(0, buy_line, OBJPROP_STYLE,  buy_style);
    ObjectSetInteger(0, buy_line, OBJPROP_WIDTH,  2);
    ObjectSetInteger(0, buy_line, OBJPROP_BACK,   true);

    // --- Sell floor line ---
    if(ObjectFind(0, sell_line) < 0)
        ObjectCreate(0, sell_line, OBJ_HLINE, 0, 0, sell_floor);
    ObjectSetDouble(0,  sell_line, OBJPROP_PRICE,  sell_floor);
    ObjectSetInteger(0, sell_line, OBJPROP_COLOR,  sell_col);
    ObjectSetInteger(0, sell_line, OBJPROP_STYLE,  sell_style);
    ObjectSetInteger(0, sell_line, OBJPROP_WIDTH,  2);
    ObjectSetInteger(0, sell_line, OBJPROP_BACK,   true);

    // --- Floating text labels pinned 10 bars to the right of the current bar ---
    datetime label_time = iTime(_Symbol, _Period, 0) + (PeriodSeconds(_Period) * 10);

    string buy_label_str = StringFormat(" BUY ZONE MAX  %.5f  [%.0f%% | RSI %.1f]",
                                        buy_ceiling,
                                        d_h1_zone_buy_pct * 100.0,
                                        d_rsi_h1_value);
    string sell_label_str = StringFormat(" SELL ZONE MIN  %.5f  [%.0f%% | RSI %.1f]",
                                         sell_floor,
                                         d_h1_zone_sel_pct * 100.0,
                                         d_rsi_h1_value);

    // Buy label
    if(ObjectFind(0, buy_txt) < 0) {
        ObjectCreate(0, buy_txt, OBJ_TEXT, 0, label_time, buy_ceiling);
        ObjectSetInteger(0, buy_txt, OBJPROP_FONTSIZE,  9);
        ObjectSetString(0,  buy_txt, OBJPROP_FONT,      "Courier New");
        ObjectSetInteger(0, buy_txt, OBJPROP_ANCHOR,    ANCHOR_LEFT_LOWER);
    }
    ObjectSetInteger(0, buy_txt, OBJPROP_TIME,   0, label_time);
    ObjectSetDouble(0,  buy_txt, OBJPROP_PRICE,  0, buy_ceiling);
    ObjectSetString(0,  buy_txt, OBJPROP_TEXT,   buy_label_str);
    ObjectSetInteger(0, buy_txt, OBJPROP_COLOR,  buy_col);

    // Sell label
    if(ObjectFind(0, sell_txt) < 0) {
        ObjectCreate(0, sell_txt, OBJ_TEXT, 0, label_time, sell_floor);
        ObjectSetInteger(0, sell_txt, OBJPROP_FONTSIZE,  9);
        ObjectSetString(0,  sell_txt, OBJPROP_FONT,      "Courier New");
        ObjectSetInteger(0, sell_txt, OBJPROP_ANCHOR,    ANCHOR_LEFT_UPPER);
    }
    ObjectSetInteger(0, sell_txt, OBJPROP_TIME,   0, label_time);
    ObjectSetDouble(0,  sell_txt, OBJPROP_PRICE,  0, sell_floor);
    ObjectSetString(0,  sell_txt, OBJPROP_TEXT,   sell_label_str);
    ObjectSetInteger(0, sell_txt, OBJPROP_COLOR,  sell_col);
}

void UpdateVisuals() {
    datetime current_time = iTime(_Symbol, _Period, 0); int highest_idx = iHighest(_Symbol, _Period, MODE_HIGH, SwingLookback, 1); int lowest_idx = iLowest(_Symbol, _Period, MODE_LOW, SwingLookback, 1);
    if(highest_idx > 0 && lowest_idx > 0) { double highest = iHigh(_Symbol, _Period, highest_idx); double lowest = iLow(_Symbol, _Period, lowest_idx); datetime t_high = iTime(_Symbol, _Period, highest_idx); datetime t_low = iTime(_Symbol, _Period, lowest_idx); if(t_high < t_low) UpdateFibo(t_high, highest, t_low, lowest); else UpdateFibo(t_low, lowest, t_high, highest); }
    ObjectsDeleteAll(0, "vis_lq_"); 
    ObjectsDeleteAll(0, "vis_deep_");
    if(Show_Liquidity_Lines) {
        for(int i = 0; i < ArraySize(active_supports); i++) { string lbl = active_supports[i].type + (active_supports[i].deep_sweep ? " [DEEP]" : ""); DrawLiquidityLine("vis_lq_sup_" + IntegerToString(i), active_supports[i].time, active_supports[i].price, current_time, lbl, clrDodgerBlue); }
        for(int i = 0; i < ArraySize(active_resistances); i++) { string lbl = active_resistances[i].type + (active_resistances[i].deep_sweep ? " [DEEP]" : ""); DrawLiquidityLine("vis_lq_res_" + IntegerToString(i), active_resistances[i].time, active_resistances[i].price, current_time, lbl, clrCrimson); }
    }
    
    if(Show_DeepSweep_Lines || Show_DeepSweep_Labels || Show_NormalSweep_Lines || Show_NormalSweep_Labels) {
        for(int i = 0; i < ArraySize(active_supports); i++) { 
            if(active_supports[i].deep_sweep) {
                double req_price = active_supports[i].price - (atr_m1[0] * DeepSweep_ATR);
                DrawDeepSweepLine("vis_deep_sup_" + IntegerToString(i), active_supports[i].time, req_price, current_time, "Deep Req", clrDodgerBlue, Show_DeepSweep_Lines, Show_DeepSweep_Labels);
            } else if(Use_Normal_Sweep) {
                double req_price = active_supports[i].price - (atr_m1[0] * NormalSweep_ATR);
                DrawDeepSweepLine("vis_deep_sup_" + IntegerToString(i), active_supports[i].time, req_price, current_time, "Normal Req", clrDodgerBlue, Show_NormalSweep_Lines, Show_NormalSweep_Labels);
            }
        }
        for(int i = 0; i < ArraySize(active_resistances); i++) { 
            if(active_resistances[i].deep_sweep) {
                double req_price = active_resistances[i].price + (atr_m1[0] * DeepSweep_ATR);
                DrawDeepSweepLine("vis_deep_res_" + IntegerToString(i), active_resistances[i].time, req_price, current_time, "Deep Req", clrCrimson, Show_DeepSweep_Lines, Show_DeepSweep_Labels);
            } else if(Use_Normal_Sweep) {
                double req_price = active_resistances[i].price + (atr_m1[0] * NormalSweep_ATR);
                DrawDeepSweepLine("vis_deep_res_" + IntegerToString(i), active_resistances[i].time, req_price, current_time, "Normal Req", clrCrimson, Show_NormalSweep_Lines, Show_NormalSweep_Labels);
            }
        }
    }
    DrawClusters(current_time); DrawContinuousBands(InpHTF1, handle_BB_M5, "vis_band_m5", M5_Visual_History, clrDarkOrange, 1, STYLE_SOLID, false); DrawContinuousBands(InpHTF2, handle_BB_H1, "vis_band_h1", H1_Visual_History, clrBlue, 1, STYLE_SOLID, true, clrDarkBlue);

    if(CountOpenPositions() > 0 && tracked_struct_level > 0 && trade_start_time > 0) {
        if(bos_armed && Use_BOS_Exit) { DrawLiquidityLine("vis_bos_track", trade_start_time, tracked_struct_level, current_time, " BOS RETEST EXITED ARMED", clrPurple); ObjectSetInteger(0, "vis_bos_track", OBJPROP_STYLE, STYLE_SOLID); ObjectSetInteger(0, "vis_bos_track", OBJPROP_WIDTH, 2); ObjectDelete(0, "vis_bos_buffer"); ObjectDelete(0, "vis_bos_buffer_txt"); } 
        else if(Use_BOS_Exit) { DrawLiquidityLine("vis_bos_track", trade_start_time, tracked_struct_level, current_time, " Tracking Entry Extreme", clrDarkOrange); ObjectSetInteger(0, "vis_bos_track", OBJPROP_STYLE, STYLE_DOT); ObjectSetInteger(0, "vis_bos_track", OBJPROP_WIDTH, 1);
            int p_type = -1; for(int i = 0; i < PositionsTotal(); i++) { if(PositionGetTicket(i) > 0 && PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == MagicNumber) { p_type = (int)PositionGetInteger(POSITION_TYPE); break; } }
            if(p_type >= 0) { double bos_buffer = atr_m1[0] * BOS_Confirm_ATR; double buffer_lvl = (p_type == POSITION_TYPE_SELL) ? tracked_struct_level + bos_buffer : tracked_struct_level - bos_buffer; DrawLiquidityLine("vis_bos_buffer", trade_start_time, buffer_lvl, current_time, " BOS Valid Close Zone", clrDimGray); ObjectSetInteger(0, "vis_bos_buffer", OBJPROP_STYLE, STYLE_DOT); }
        }
    } else { ObjectDelete(0, "vis_bos_track"); ObjectDelete(0, "vis_bos_track_txt"); ObjectDelete(0, "vis_bos_buffer"); ObjectDelete(0, "vis_bos_buffer_txt"); }

    // NEW: Draw RSI-adaptive H1 zone boundary lines
    DrawRSIZoneLines();

    // NEW: Draw H1 Mean Zone Validation lines
    DrawH1MeanZoneLines();

    // NEW: Draw H1 detected swing + Fib gate lines for visual verification

    // NEW: Draw M1 Momentum State Points
    DrawM1MomentumPoints();

    // NEW: Draw Historical Candle Speeds
    DrawCandleSpeeds();
    
    // NEW: Draw M1 Bypass Zones
    DrawM1BypassZones();
    
    // NEW: Draw Unretested Fractal Zones
    DrawUnretestedVisuals();
}

//+------------------------------------------------------------------+
//| Unretested Fractal Filter Visuals                                |
//+------------------------------------------------------------------+
void DrawUnretestedVisuals() {
    ObjectDelete(0, "vis_ur_recent");
    ObjectDelete(0, "vis_ur_prev");
    
    if(!Use_Unretested_Fractal_Filter || !Show_Unretested_Visuals) return;
    
    datetime current_time = iTime(_Symbol, _Period, 0);

    if(d_ur_recent_top_t > 0 && d_ur_recent_bot_t > 0 && d_ur_prev_top_t > 0 && d_ur_prev_bot_t > 0) {
        // Determine coloring based on the gap state
        bool is_overlapping = (d_ur_recent_top >= d_ur_prev_bot && d_ur_recent_bot <= d_ur_prev_top);
        color box_col = is_overlapping ? clrDarkSlateGray : clrCrimson; 
        
        // RECENT RANGE RECTANGLE
        datetime rec_t1 = MathMin(d_ur_recent_top_t, d_ur_recent_bot_t);
        if(ObjectFind(0, "vis_ur_recent") < 0) ObjectCreate(0, "vis_ur_recent", OBJ_RECTANGLE, 0, 0, 0, 0, 0);
        ObjectSetInteger(0, "vis_ur_recent", OBJPROP_TIME, 0, rec_t1);
        ObjectSetDouble(0, "vis_ur_recent", OBJPROP_PRICE, 0, d_ur_recent_top);
        ObjectSetInteger(0, "vis_ur_recent", OBJPROP_TIME, 1, current_time);
        ObjectSetDouble(0, "vis_ur_recent", OBJPROP_PRICE, 1, d_ur_recent_bot);
        ObjectSetInteger(0, "vis_ur_recent", OBJPROP_COLOR, box_col);
        ObjectSetInteger(0, "vis_ur_recent", OBJPROP_FILL, true);
        ObjectSetInteger(0, "vis_ur_recent", OBJPROP_BACK, true);
        
        // PREVIOUS RANGE RECTANGLE
        datetime prev_t1 = MathMin(d_ur_prev_top_t, d_ur_prev_bot_t);
        datetime prev_t2 = rec_t1; // Stretch it to meet the recent rectangle
        if(ObjectFind(0, "vis_ur_prev") < 0) ObjectCreate(0, "vis_ur_prev", OBJ_RECTANGLE, 0, 0, 0, 0, 0);
        ObjectSetInteger(0, "vis_ur_prev", OBJPROP_TIME, 0, prev_t1);
        ObjectSetDouble(0, "vis_ur_prev", OBJPROP_PRICE, 0, d_ur_prev_top);
        ObjectSetInteger(0, "vis_ur_prev", OBJPROP_TIME, 1, prev_t2);
        ObjectSetDouble(0, "vis_ur_prev", OBJPROP_PRICE, 1, d_ur_prev_bot);
        ObjectSetInteger(0, "vis_ur_prev", OBJPROP_COLOR, box_col);
        ObjectSetInteger(0, "vis_ur_prev", OBJPROP_FILL, true);
        ObjectSetInteger(0, "vis_ur_prev", OBJPROP_BACK, true);
    }
}

//+------------------------------------------------------------------+
//| Historical Candle Speed Visuals                                  |
//|                                                                  |
//| Reconstructs the Open-to-Close speed (pts/sec) for the last      |
//| N candles (tied to Candle_Speed_Lookback) and prints them on the |
//| chart above/below the candles so the user can visualize speed.   |
//+------------------------------------------------------------------+
void DrawCandleSpeeds() {
    if(!Show_Candle_Speeds) {
        ObjectsDeleteAll(0, "vis_speed_");
        return;
    }
    
    int limit = MathMin(Candle_Speed_Lookback, Bars(_Symbol, _Period) - 1);
    
    // Clean up older text objects that have fallen out of the lookback window
    for(int i = limit + 1; i <= limit + 20; i++) {
        ObjectDelete(0, "vis_speed_" + IntegerToString(iTime(_Symbol, _Period, i)));
    }

    for(int i = 0; i <= limit; i++) {
        datetime bar_time = iTime(_Symbol, _Period, i);
        string obj_name = "vis_speed_" + IntegerToString(bar_time);
        
        // Calculate the speed of the historical candle
        double open_p  = iOpen(_Symbol, _Period, i);
        double close_p = iClose(_Symbol, _Period, i);
        double pips_diff = (close_p - open_p) / _Point; // negative for down candle
        
        // Candle duration in seconds
        long time_sec = PeriodSeconds(_Period);
        if(i == 0) {
            time_sec = TimeCurrent() - bar_time;
            if(time_sec <= 0) time_sec = 1; // Prevent division by 0 on exact open second
        }
        
        double pips_per_sec = 0.0;
        if(time_sec > 0) pips_per_sec = pips_diff / (double)time_sec;
        
        string speed_text = StringFormat("%.2f", pips_per_sec);
        
        bool is_bullish = (close_p >= open_p);
        
        double target_price;
        color text_color;
        int anchor;
        
        // Dynamic offset using ATR
        double atr_val = 0.0;
        if(i < ArraySize(atr_m1)) atr_val = atr_m1[i];
        else atr_val = atr_m1[0];
        if(atr_val <= 0) atr_val = (iHigh(_Symbol, _Period, i) - iLow(_Symbol, _Period, i));
        
        double offset = atr_val * 0.15;
        
        if(is_bullish) {
            target_price = iLow(_Symbol, _Period, i) - offset;
            text_color = clrMediumSeaGreen;
            anchor = ANCHOR_TOP;
        } else {
            target_price = iHigh(_Symbol, _Period, i) + offset;
            text_color = clrIndianRed;
            anchor = ANCHOR_BOTTOM;
        }
        
        if(ObjectFind(0, obj_name) < 0) {
            ObjectCreate(0, obj_name, OBJ_TEXT, 0, bar_time, target_price);
            ObjectSetString(0, obj_name, OBJPROP_FONT, "Arial");
            ObjectSetInteger(0, obj_name, OBJPROP_FONTSIZE, 8);
            ObjectSetInteger(0, obj_name, OBJPROP_BACK, false);
            ObjectSetInteger(0, obj_name, OBJPROP_SELECTABLE, false);
            ObjectSetInteger(0, obj_name, OBJPROP_HIDDEN, true);
        }
        
        // Update properties every tick in case price/ATR shifts dynamically
        ObjectSetInteger(0, obj_name, OBJPROP_TIME, bar_time);
        ObjectSetDouble(0, obj_name, OBJPROP_PRICE, target_price);
        ObjectSetString(0, obj_name, OBJPROP_TEXT, speed_text);
        ObjectSetInteger(0, obj_name, OBJPROP_COLOR, text_color);
        ObjectSetInteger(0, obj_name, OBJPROP_ANCHOR, anchor);
    }
}


//+------------------------------------------------------------------+
//| M1 HH/LL Momentum Visual Points (Historical & Current)           |
//|                                                                  |
//| Draws a dot (Wingdings 159) on the candles indicating the        |
//| M1 momentum state based on the HH/LL ratio.                      |
//|   Strong UP   (Red):   Placed above the high                     |
//|   Strong DOWN (Red):   Placed below the low                      |
//|   Ranging     (Green): Placed near the close                     |
//|   Neutral     (Gray):  Placed near the close                     |
//+------------------------------------------------------------------+
void DrawM1MomentumPoints() {
    if(!Use_M1_Momentum) {
        ObjectsDeleteAll(0, "vis_m1_mom_pt_");
        return;
    }

    int history_bars = 200; // Draw points for the last 200 bars for history
    int available_bars = iBars(_Symbol, _Period);
    if(history_bars > available_bars - M1_Mom_Lookback - 1) 
        history_bars = available_bars - M1_Mom_Lookback - 1;

    for(int i = 0; i < history_bars; i++) {
        string obj_name = "vis_m1_mom_pt_" + IntegerToString(i);
        
        // Calculate historical HH/LL ratio for bar i
        int hh_count = 0;
        int ll_count = 0;
        int start_k = 1;
        if (M1_Mom_Include_Current) {
            start_k = 0;
        } else if (M1_Mom_Include_If_Broken) {
            if (iHigh(_Symbol, _Period, i) > iHigh(_Symbol, _Period, i + 1) || 
                iLow(_Symbol, _Period, i) < iLow(_Symbol, _Period, i + 1)) {
                start_k = 0;
            }
        }
        for(int k = start_k; k < M1_Mom_Lookback + start_k; k++) {
            if(iHigh(_Symbol, _Period, i + k) > iHigh(_Symbol, _Period, i + k + 1)) hh_count++;
            if(iLow(_Symbol, _Period, i + k) < iLow(_Symbol, _Period, i + k + 1)) ll_count++;
        }
        
        int total_moves = hh_count + ll_count;
        double hist_ratio = 50.0;
        if(total_moves > 0) {
            hist_ratio = ((double)hh_count / (double)total_moves) * 100.0;
        }

        int hist_trend = 0;
        bool hist_ranging = false;

        if(hist_ratio >= M1_Mom_Trend_Threshold) hist_trend = 1; 
        else if(hist_ratio <= (100.0 - M1_Mom_Trend_Threshold)) hist_trend = -1;
        
        if(hist_ratio <= M1_Mom_Range_Threshold && hist_ratio >= (100.0 - M1_Mom_Range_Threshold)) {
            hist_ranging = true;
        }

        datetime bar_time = iTime(_Symbol, _Period, i);
        double cur_high = iHigh(_Symbol, _Period, i);
        double cur_low = iLow(_Symbol, _Period, i);
        double cur_close = iClose(_Symbol, _Period, i);
        
        // Use a safe ATR for distance. For current bar use atr_m1[0], for history use atr_m1[i] if available
        double atr_val = 0.0;
        if (i < ArraySize(atr_m1)) atr_val = atr_m1[i];
        else atr_val = atr_m1[0]; // fallback
        if (atr_val <= 0) atr_val = (cur_high - cur_low) * 0.5; // fallback 2

        double point_dist = atr_val * 0.2; 

        double target_price;
        color target_color;

        if(hist_trend == 1) { // Strong UP
            target_price = cur_high + point_dist;
            target_color = clrRed;
        } else if(hist_trend == -1) { // Strong DOWN
            target_price = cur_low - point_dist;
            target_color = clrRed;
        } else if(hist_ranging) { // Ranging
            target_price = cur_close; 
            target_color = clrGreen;
        } else { // Neutral
            target_price = cur_close;
            target_color = clrGray;
        }

        if(ObjectFind(0, obj_name) < 0) {
            ObjectCreate(0, obj_name, OBJ_ARROW, 0, bar_time, target_price);
            ObjectSetInteger(0, obj_name, OBJPROP_ARROWCODE, 159); // Wingdings dot
            ObjectSetInteger(0, obj_name, OBJPROP_WIDTH, 2);
            ObjectSetInteger(0, obj_name, OBJPROP_BACK, false);
        } else {
            ObjectSetInteger(0, obj_name, OBJPROP_TIME, bar_time);
            ObjectSetDouble(0, obj_name, OBJPROP_PRICE, target_price);
            ObjectSetInteger(0, obj_name, OBJPROP_COLOR, target_color);
        }
    }
}

//+------------------------------------------------------------------+
//| M1 Bypass Zones Visuals                                          |
//+------------------------------------------------------------------+
void DrawM1BypassZones() {
    string push_zone_name = "vis_mb_push";
    string prev_zone_name = "vis_mb_prev";
    
    if(!M1_Mom_Bypass_Extreme || !M1_Mom_Bypass_ShowRect || g_mb_start_idx == -1) {
        ObjectDelete(0, push_zone_name);
        ObjectDelete(0, prev_zone_name);
        return;
    }
    
    double push_max = 0, push_min = 999999;
    for(int k=MathMin(g_mb_end_idx, g_mb_start_idx); k<=MathMax(g_mb_end_idx, g_mb_start_idx); k++) {
        if(iHigh(_Symbol, _Period, k) > push_max) push_max = iHigh(_Symbol, _Period, k);
        if(iLow(_Symbol, _Period, k)  < push_min) push_min = iLow(_Symbol, _Period, k);
    }
    
    double prev_max = 0, prev_min = 999999;
    for(int k=MathMin(g_mb_prev_end_idx, g_mb_prev_start_idx); k<=MathMax(g_mb_prev_end_idx, g_mb_prev_start_idx); k++) {
        if(iHigh(_Symbol, _Period, k) > prev_max) prev_max = iHigh(_Symbol, _Period, k);
        if(iLow(_Symbol, _Period, k)  < prev_min) prev_min = iLow(_Symbol, _Period, k);
    }
    
    datetime push_time1 = iTime(_Symbol, _Period, g_mb_start_idx);
    datetime push_time2 = iTime(_Symbol, _Period, g_mb_end_idx);
    datetime prev_time1 = iTime(_Symbol, _Period, g_mb_prev_start_idx);
    datetime prev_time2 = iTime(_Symbol, _Period, g_mb_prev_end_idx);

    // Draw push zone
    if(ObjectFind(0, push_zone_name) < 0) {
        ObjectCreate(0, push_zone_name, OBJ_RECTANGLE, 0, push_time1, push_max, push_time2, push_min);
        ObjectSetInteger(0, push_zone_name, OBJPROP_COLOR, (g_mb_trend_dir == 1 ? clrLightGreen : clrLightPink));
        ObjectSetInteger(0, push_zone_name, OBJPROP_BACK, true);
        ObjectSetInteger(0, push_zone_name, OBJPROP_FILL, true);
    } else {
        ObjectSetInteger(0, push_zone_name, OBJPROP_TIME, 0, push_time1);
        ObjectSetDouble(0, push_zone_name, OBJPROP_PRICE, 0, push_max);
        ObjectSetInteger(0, push_zone_name, OBJPROP_TIME, 1, push_time2);
        ObjectSetDouble(0, push_zone_name, OBJPROP_PRICE, 1, push_min);
        ObjectSetInteger(0, push_zone_name, OBJPROP_COLOR, (g_mb_trend_dir == 1 ? clrLightGreen : clrLightPink));
    }
    
    // Draw prev zone
    if(ObjectFind(0, prev_zone_name) < 0) {
        ObjectCreate(0, prev_zone_name, OBJ_RECTANGLE, 0, prev_time1, prev_max, prev_time2, prev_min);
        ObjectSetInteger(0, prev_zone_name, OBJPROP_COLOR, clrSilver);
        ObjectSetInteger(0, prev_zone_name, OBJPROP_BACK, true);
        ObjectSetInteger(0, prev_zone_name, OBJPROP_FILL, true);
    } else {
        ObjectSetInteger(0, prev_zone_name, OBJPROP_TIME, 0, prev_time1);
        ObjectSetDouble(0, prev_zone_name, OBJPROP_PRICE, 0, prev_max);
        ObjectSetInteger(0, prev_zone_name, OBJPROP_TIME, 1, prev_time2);
        ObjectSetDouble(0, prev_zone_name, OBJPROP_PRICE, 1, prev_min);
    }
}

//+------------------------------------------------------------------+
//| H1 Mean Zone Visual Lines                                        |
//|                                                                  |
//| Draws a horizontal dashed line on the chart showing where        |
//| price must be for the EA to consider a valid H1 mean zone        |
//| trade during a trend.                                            |
//|   Aqua   dashed = Buy zone ceiling  (price must be <= this)      |
//|   Orange dashed = Sell zone floor   (price must be >= this)      |
//| Lines are hidden when the trend is neutral or missing.           |
//+------------------------------------------------------------------+
void DrawH1MeanZoneLines() {
    string buy_line  = "vis_h1mean_buy_line";
    string sell_line = "vis_h1mean_sell_line";
    string buy_txt   = "vis_h1mean_buy_txt";
    string sell_txt  = "vis_h1mean_sell_txt";

    // Clean up if there is no trend 
    if(d_h1_trend == 0) {
        ObjectDelete(0, buy_line);
        ObjectDelete(0, sell_line);
        ObjectDelete(0, buy_txt);
        ObjectDelete(0, sell_txt);
        return;
    }

    double h1_range      = bb_up_h1[0] - bb_dn_h1[0];
    double buy_ceiling   = bb_base_h1[0] + (h1_range * d_h1_mean_zone_pct);  // Price must be <= this for buy
    double sell_floor    = bb_base_h1[0] - (h1_range * d_h1_mean_zone_pct);  // Price must be >= this for sell

    // --- Floating text labels pinned 10 bars to the right of the current bar ---
    datetime label_time = iTime(_Symbol, _Period, 0) + (PeriodSeconds(_Period) * 10);

    if(d_h1_trend == 1) { // Up trend
        // Draw the Buy ceiling
        if(ObjectFind(0, buy_line) < 0) ObjectCreate(0, buy_line, OBJ_HLINE, 0, 0, buy_ceiling);
        ObjectSetDouble(0,  buy_line, OBJPROP_PRICE,  buy_ceiling);
        ObjectSetInteger(0, buy_line, OBJPROP_COLOR,  clrAqua);
        ObjectSetInteger(0, buy_line, OBJPROP_STYLE,  STYLE_DASH);
        ObjectSetInteger(0, buy_line, OBJPROP_WIDTH,  1);
        ObjectSetInteger(0, buy_line, OBJPROP_BACK,   true);

        if(ObjectFind(0, buy_txt) < 0) {
            ObjectCreate(0, buy_txt, OBJ_TEXT, 0, label_time, buy_ceiling);
            ObjectSetInteger(0, buy_txt, OBJPROP_FONTSIZE,  9);
            ObjectSetString(0,  buy_txt, OBJPROP_FONT,      "Courier New");
            ObjectSetInteger(0, buy_txt, OBJPROP_ANCHOR,    ANCHOR_LEFT_LOWER);
        }
        ObjectSetInteger(0, buy_txt, OBJPROP_TIME,   0, label_time);
        ObjectSetDouble(0,  buy_txt, OBJPROP_PRICE,  0, buy_ceiling);
        ObjectSetString(0,  buy_txt, OBJPROP_TEXT,   StringFormat(" H1 BUY MEAN ZONE MAX  %.5f [%.1f%%]", buy_ceiling, d_h1_mean_zone_pct * 100.0));
        ObjectSetInteger(0, buy_txt, OBJPROP_COLOR,  clrAqua);

        // Hide Sell line if any
        ObjectDelete(0, sell_line);
        ObjectDelete(0, sell_txt);
    } 
    else if(d_h1_trend == -1) { // Down trend
        // Draw the Sell floor
        if(ObjectFind(0, sell_line) < 0) ObjectCreate(0, sell_line, OBJ_HLINE, 0, 0, sell_floor);
        ObjectSetDouble(0,  sell_line, OBJPROP_PRICE,  sell_floor);
        ObjectSetInteger(0, sell_line, OBJPROP_COLOR,  clrCoral);
        ObjectSetInteger(0, sell_line, OBJPROP_STYLE,  STYLE_DASH);
        ObjectSetInteger(0, sell_line, OBJPROP_WIDTH,  1);
        ObjectSetInteger(0, sell_line, OBJPROP_BACK,   true);

        if(ObjectFind(0, sell_txt) < 0) {
            ObjectCreate(0, sell_txt, OBJ_TEXT, 0, label_time, sell_floor);
            ObjectSetInteger(0, sell_txt, OBJPROP_FONTSIZE,  9);
            ObjectSetString(0,  sell_txt, OBJPROP_FONT,      "Courier New");
            ObjectSetInteger(0, sell_txt, OBJPROP_ANCHOR,    ANCHOR_LEFT_UPPER);
        }
        ObjectSetInteger(0, sell_txt, OBJPROP_TIME,   0, label_time);
        ObjectSetDouble(0,  sell_txt, OBJPROP_PRICE,  0, sell_floor);
        ObjectSetString(0,  sell_txt, OBJPROP_TEXT,   StringFormat(" H1 SELL MEAN ZONE MIN  %.5f [%.1f%%]", sell_floor, d_h1_mean_zone_pct * 100.0));
        ObjectSetInteger(0, sell_txt, OBJPROP_COLOR,  clrCoral);

        // Hide Buy line if any
        ObjectDelete(0, buy_line);
        ObjectDelete(0, buy_txt);
    }
}

//+------------------------------------------------------------------+
//| Draw H1 Detected Swing + Fib Gate Lines                          |
//|                                                                  |
//| Draws three horizontal lines on the chart so the user can        |
//| visually verify which swing the EA is using for extensions:      |
//|   Cyan  dashed  = detected swing HIGH (pullback bar peak)        |
//|   Yellow dashed = detected swing LOW  (bottom of last leg)       |
//|   White  solid  = Fib extension gate price (unlock level)        |
//| Lines are hidden when the gate is NEUTRAL or disabled.           |
//+------------------------------------------------------------------+

void DrawClusters(datetime current_time) {
    ObjectsDeleteAll(0, "vis_clust_"); 
    if(!Show_Liquidity_Clusters) return;
    double cluster_dist = atr_m1[0] * ClusterToleranceATR;
    for(int i = 0; i < ArraySize(active_supports); i++) { double sup_price = active_supports[i].price; double lowest_in_cluster = sup_price; datetime start_time = active_supports[i].time; bool is_cluster = false; for(int j = 0; j < ArraySize(active_supports); j++) { double other_sup = active_supports[j].price; if(other_sup < sup_price && (sup_price - other_sup) <= cluster_dist) { is_cluster = true; if(other_sup < lowest_in_cluster) lowest_in_cluster = other_sup; if(active_supports[j].time < start_time) start_time = active_supports[j].time; } } if(is_cluster) { DrawZone("vis_clust_sup_" + IntegerToString(i), start_time, sup_price, current_time, lowest_in_cluster, clrDodgerBlue); } }
    for(int i = 0; i < ArraySize(active_resistances); i++) { double res_price = active_resistances[i].price; double highest_in_cluster = res_price; datetime start_time = active_resistances[i].time; bool is_cluster = false; for(int j = 0; j < ArraySize(active_resistances); j++) { double other_res = active_resistances[j].price; if(other_res > res_price && (other_res - res_price) <= cluster_dist) { is_cluster = true; if(other_res > highest_in_cluster) highest_in_cluster = other_res; if(active_resistances[j].time < start_time) start_time = active_resistances[j].time; } } if(is_cluster) { DrawZone("vis_clust_res_" + IntegerToString(i), start_time, highest_in_cluster, current_time, res_price, clrCrimson); } }
}

void DrawZone(string name, datetime t1, double p1, datetime t2, double p2, color col) { ObjectCreate(0, name, OBJ_RECTANGLE, 0, t1, p1, t2, p2); ObjectSetInteger(0, name, OBJPROP_COLOR, col); ObjectSetInteger(0, name, OBJPROP_FILL, true); ObjectSetInteger(0, name, OBJPROP_BACK, true); }
void DrawContinuousBands(ENUM_TIMEFRAMES tf, int handle, string prefix, int count, color col, int width, int style, bool draw_base=false, color base_col=clrNONE) { double up[], dn[], base[]; datetime time[]; if(CopyBuffer(handle, 1, 0, count, up) <= 0 || CopyBuffer(handle, 2, 0, count, dn) <= 0 || CopyTime(_Symbol, tf, 0, count, time) <= 0) return; if(draw_base && CopyBuffer(handle, 0, 0, count, base) <= 0) return; datetime current_m1_time = iTime(_Symbol, _Period, 0); for(int i = 0; i < count - 1; i++) { datetime t1 = time[i]; datetime t2 = time[i+1]; if(i == count - 2) t2 = current_m1_time; string name_up = prefix + "_up_" + IntegerToString(i); if(ObjectFind(0, name_up) < 0) { ObjectCreate(0, name_up, OBJ_TREND, 0, t1, up[i], t2, up[i+1]); ObjectSetInteger(0, name_up, OBJPROP_COLOR, col); ObjectSetInteger(0, name_up, OBJPROP_STYLE, style); ObjectSetInteger(0, name_up, OBJPROP_WIDTH, width); ObjectSetInteger(0, name_up, OBJPROP_RAY_RIGHT, false); ObjectSetInteger(0, name_up, OBJPROP_BACK, true); } else { ObjectSetInteger(0, name_up, OBJPROP_TIME, 0, t1); ObjectSetDouble(0, name_up, OBJPROP_PRICE, 0, up[i]); ObjectSetInteger(0, name_up, OBJPROP_TIME, 1, t2); ObjectSetDouble(0, name_up, OBJPROP_PRICE, 1, up[i+1]); } string name_dn = prefix + "_dn_" + IntegerToString(i); if(ObjectFind(0, name_dn) < 0) { ObjectCreate(0, name_dn, OBJ_TREND, 0, t1, dn[i], t2, dn[i+1]); ObjectSetInteger(0, name_dn, OBJPROP_COLOR, col); ObjectSetInteger(0, name_dn, OBJPROP_STYLE, style); ObjectSetInteger(0, name_dn, OBJPROP_WIDTH, width); ObjectSetInteger(0, name_dn, OBJPROP_RAY_RIGHT, false); ObjectSetInteger(0, name_dn, OBJPROP_BACK, true); } else { ObjectSetInteger(0, name_dn, OBJPROP_TIME, 0, t1); ObjectSetDouble(0, name_dn, OBJPROP_PRICE, 0, dn[i]); ObjectSetInteger(0, name_dn, OBJPROP_TIME, 1, t2); ObjectSetDouble(0, name_dn, OBJPROP_PRICE, 1, dn[i+1]); } if(draw_base) { string name_base = prefix + "_base_" + IntegerToString(i); if(ObjectFind(0, name_base) < 0) { ObjectCreate(0, name_base, OBJ_TREND, 0, t1, base[i], t2, base[i+1]); ObjectSetInteger(0, name_base, OBJPROP_COLOR, base_col); ObjectSetInteger(0, name_base, OBJPROP_STYLE, STYLE_DASH); ObjectSetInteger(0, name_base, OBJPROP_WIDTH, width); ObjectSetInteger(0, name_base, OBJPROP_RAY_RIGHT, false); ObjectSetInteger(0, name_base, OBJPROP_BACK, true); } else { ObjectSetInteger(0, name_base, OBJPROP_TIME, 0, t1); ObjectSetDouble(0, name_base, OBJPROP_PRICE, 0, base[i]); ObjectSetInteger(0, name_base, OBJPROP_TIME, 1, t2); ObjectSetDouble(0, name_base, OBJPROP_PRICE, 1, base[i+1]); } } } }
void DrawLiquidityLine(string name, datetime t1, double price, datetime t2, string label_text, color col) {
    string text_name = name + "_txt";
    ObjectCreate(0, name, OBJ_TREND, 0, t1, price, t2, price);
    ObjectSetInteger(0, name, OBJPROP_COLOR, col);
    ObjectSetInteger(0, name, OBJPROP_STYLE, STYLE_DASH);
    ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false);
    ObjectSetInteger(0, name, OBJPROP_WIDTH, 1);
    if(Show_LQ_Labels) {
        ObjectCreate(0, text_name, OBJ_TEXT, 0, t2, price);
        ObjectSetString(0, text_name, OBJPROP_TEXT, " " + label_text);
        ObjectSetInteger(0, text_name, OBJPROP_COLOR, col);
        ObjectSetInteger(0, text_name, OBJPROP_ANCHOR, ANCHOR_LEFT_LOWER);
        ObjectSetInteger(0, text_name, OBJPROP_FONTSIZE, 9);
    } else {
        ObjectDelete(0, text_name); // remove if it was previously created
    }
}

void DrawDeepSweepLine(string name, datetime t1, double price, datetime t2, string label_text, color col, bool show_line, bool show_label) {
