        ObjectSetInteger(0, text_name, OBJPROP_ANCHOR, ANCHOR_LEFT_LOWER);
        ObjectSetInteger(0, text_name, OBJPROP_FONTSIZE, 8);
    }
}
void UpdateFibo(datetime t1, double p1, datetime t2, double p2) { string name = "visual_swing_fibo"; if(ObjectFind(0, name) < 0) { ObjectCreate(0, name, OBJ_FIBO, 0, t1, p1, t2, p2); ObjectSetInteger(0, name, OBJPROP_COLOR, clrPurple); ObjectSetInteger(0, name, OBJPROP_LEVELCOLOR, clrPurple); ObjectSetInteger(0, name, OBJPROP_RAY_RIGHT, false); ObjectSetInteger(0, name, OBJPROP_LEVELS, 5); ObjectSetDouble(0, name, OBJPROP_LEVELVALUE, 0, 0.0); ObjectSetString(0, name, OBJPROP_LEVELTEXT, 0, "0.0"); ObjectSetDouble(0, name, OBJPROP_LEVELVALUE, 1, 0.382); ObjectSetString(0, name, OBJPROP_LEVELTEXT, 1, "38.2 (%)"); ObjectSetDouble(0, name, OBJPROP_LEVELVALUE, 2, 0.5); ObjectSetString(0, name, OBJPROP_LEVELTEXT, 2, "50.0 (%)"); ObjectSetDouble(0, name, OBJPROP_LEVELVALUE, 3, 0.618); ObjectSetString(0, name, OBJPROP_LEVELTEXT, 3, "61.8 (%)"); ObjectSetDouble(0, name, OBJPROP_LEVELVALUE, 4, 1.0); ObjectSetString(0, name, OBJPROP_LEVELTEXT, 4, "100.0"); } else { ObjectSetInteger(0, name, OBJPROP_TIME, 0, t1); ObjectSetDouble(0, name, OBJPROP_PRICE, 0, p1); ObjectSetInteger(0, name, OBJPROP_TIME, 1, t2); ObjectSetDouble(0, name, OBJPROP_PRICE, 1, p2); } }

//+------------------------------------------------------------------+
//| MSS Fractal Level Helpers                                        |
//| Returns the most recently formed valid fractal low/high.         |
//+------------------------------------------------------------------+
double GetMostRecentFractalLow(int start_index = 2) {
    int limit = MathMin(start_index + 200, iBars(_Symbol, _Period) - 1); // Check up to 200 bars back
    for(int i = start_index; i <= limit; i++) {
        if(IsBottomFractal(i)) return iLow(_Symbol, _Period, i);
    }
    return 0.0;
}

double GetMostRecentFractalHigh(int start_index = 2) {
    int limit = MathMin(start_index + 200, iBars(_Symbol, _Period) - 1); 
    for(int i = start_index; i <= limit; i++) {
        if(IsTopFractal(i)) return iHigh(_Symbol, _Period, i);
    }
    return 0.0;
}

//+------------------------------------------------------------------+
//| BOS Fractal Level Helpers                                        |
//|                                                                  |
//| For BUY trades (bos_armed due to price breaking DOWN):           |
//|   Returns the LOWEST confirmed fractal low that has been broken  |
//|   (price wicked below it) — the most recently broken level going |
//|   downward is the lowest one price has already been through.     |
//|                                                                  |
//| For SELL trades (bos_armed due to price breaking UP):            |
//|   Returns the HIGHEST confirmed fractal high that has been       |
//|   broken (price wicked above it).                                |
//|                                                                  |
//| Key design decisions:                                            |
//|  - Start i at 4: minimum bar index to have at least one free j   |
//|    (bars i-1 and i-2 are the fractal's right guards — by         |
//|     definition their high/low can never exceed the fractal,      |
//|     so they're useless for the broken check).                    |
//|  - Limit j <= i-3: only check bars that are NOT fractal guards.  |
//|  - Use iHigh/iLow (not iClose): catches wicks through the level, |
//|    which is sufficient to call the fractal "broken."             |
//+------------------------------------------------------------------+
double FindMostRecentBrokenFractalLow(int entry_bar) {
    int limit = MathMin(entry_bar + 1, SwingLookback);
    double best_level = 0.0; // Will hold the LOWEST broken fractal low found
    for(int i = 4; i <= limit; i++) {
        if(!IsBottomFractal(i)) continue;
        double f_low = iLow(_Symbol, _Period, i);
        // Only check bars that are free from the fractal's right-guard constraint
        for(int j = 1; j <= i-3; j++) {
            if(iLow(_Symbol, _Period, j) < f_low) {
                // Fractal is broken; track the LOWEST (most extreme = most recently broken going down)
                if(best_level == 0.0 || f_low < best_level) best_level = f_low;
                break;
            }
        }
    }
    return best_level;
}

double FindMostRecentBrokenFractalHigh(int entry_bar) {
    int limit = MathMin(entry_bar + 1, SwingLookback);
    double best_level = 0.0; // Will hold the HIGHEST broken fractal high found
    for(int i = 4; i <= limit; i++) {
        if(!IsTopFractal(i)) continue;
        double f_high = iHigh(_Symbol, _Period, i);
        // Only check bars that are free from the fractal's right-guard constraint
        for(int j = 1; j <= i-3; j++) {
            if(iHigh(_Symbol, _Period, j) > f_high) {
                // Fractal is broken; track the HIGHEST (most extreme = most recently broken going up)
                if(f_high > best_level) best_level = f_high;
                break;
            }
        }
    }
    return best_level;
}



//+------------------------------------------------------------------+
//| Trade Management                                                 |
//+------------------------------------------------------------------+
void ManageOpenTrades() {
    for(int i = PositionsTotal() - 1; i >= 0; i--) {
        ulong ticket = PositionGetTicket(i);
        if(PositionGetString(POSITION_SYMBOL) == _Symbol && PositionGetInteger(POSITION_MAGIC) == MagicNumber) {
            
            int pos_type = (int)PositionGetInteger(POSITION_TYPE);
            double current_price = pos_type == POSITION_TYPE_BUY ? SymbolInfoDouble(_Symbol, SYMBOL_BID) : SymbolInfoDouble(_Symbol, SYMBOL_ASK);
            double open_price = PositionGetDouble(POSITION_PRICE_OPEN);
            
            datetime open_time = (datetime)PositionGetInteger(POSITION_TIME);
            int entry_bar = iBarShift(_Symbol, _Period, open_time);
            if(entry_bar < 0) entry_bar = 0; 

            // 0. HTF Squeeze Emergency Exit (highest priority — protects from squeeze explosion)
            bool bypass_sqz = (active_trade_is_upgraded && Bypass_Squeeze_Exit_On_HTF);
            
            if(!bypass_sqz) {
                if((Exit_Trade_On_H1_Squeeze && h1_squeeze_danger) ||
                   (Exit_Trade_On_M5_Squeeze && m5_squeeze_danger) ||
                   (Exit_Trade_On_M1_Squeeze && m1_squeeze_danger)) {
                    ClosePositionAggressive(ticket);
                    continue;
                }
            }

            // 1. Initialize Trackers for new trades
            if(current_ticket != ticket) {
                current_ticket = ticket;
                bos_armed = false;
                tracked_struct_level = 0.0;
                trade_start_time = open_time;
                mh_mean_pullback_done = false; // Reset per-trade flag
                // DO NOT overwrite active_trade_is_upgraded here!
                // It was just calculated and set in CheckEntry() -> InitDynamicTP()
                
                // Evaluate Momentum Spike Condition at Entry (Shifted ATR)
                trade_is_spike = true; 
                if(Require_Spike_Entry) {
                    double max_h = 0.0;
                    double min_l = 999999.0;
                    for(int k = entry_bar; k < entry_bar + Spike_Lookback_Bars; k++) {
                        double h = iHigh(_Symbol, _Period, k);
                        double l = iLow(_Symbol, _Period, k);
                        if(h > max_h) max_h = h;
                        if(l < min_l) min_l = l;
                    }
                    double setup_range = max_h - min_l;
                    
                    int safe_shift = entry_bar + Spike_ATR_Shift;
                    if(safe_shift >= ArraySize(atr_m1)) safe_shift = ArraySize(atr_m1) - 1;
                    
                    if(atr_m1[safe_shift] > 0 && setup_range < (atr_m1[safe_shift] * Spike_ATR_Multiplier)) {
                        trade_is_spike = false;
                    }
                }
            }

            // 2. Lock Strict Entry Structure Extreme & Check Meaningful BOS
            if(!bos_armed && Use_BOS_Exit) {
                double bos_buffer = atr_m1[0] * BOS_Confirm_ATR; 
                if(pos_type == POSITION_TYPE_SELL) {
                    if(tracked_struct_level == 0.0) { int high_idx = iHighest(_Symbol, _Period, MODE_HIGH, 5, entry_bar); if(high_idx >= 0) tracked_struct_level = iHigh(_Symbol, _Period, high_idx); }
                    if(entry_bar == 0 && iHigh(_Symbol, _Period, 0) > tracked_struct_level) tracked_struct_level = iHigh(_Symbol, _Period, 0);
                    if(tracked_struct_level > 0 && entry_bar > 0 && iClose(_Symbol, _Period, 1) > (tracked_struct_level + bos_buffer)) {
                        bos_armed = true;
                        // FIX: update tracked level to the most recent broken fractal high so
                        // the retest exit waits at the correct level (not the stale entry extreme)
                        double broken_fractal = FindMostRecentBrokenFractalHigh(entry_bar);
                        if(broken_fractal > 0) tracked_struct_level = broken_fractal;
                    }
                }
                else if(pos_type == POSITION_TYPE_BUY) {
                    if(tracked_struct_level == 0.0) { int low_idx = iLowest(_Symbol, _Period, MODE_LOW, 5, entry_bar); if(low_idx >= 0) tracked_struct_level = iLow(_Symbol, _Period, low_idx); }
                    if(entry_bar == 0 && iLow(_Symbol, _Period, 0) < tracked_struct_level) tracked_struct_level = iLow(_Symbol, _Period, 0);
                    if(tracked_struct_level > 0 && entry_bar > 0 && iClose(_Symbol, _Period, 1) < (tracked_struct_level - bos_buffer)) {
                        bos_armed = true;
                        // FIX: update tracked level to the most recent broken fractal low so
                        // the retest exit waits at the correct level (not the stale entry extreme)
                        double broken_fractal = FindMostRecentBrokenFractalLow(entry_bar);
                        if(broken_fractal > 0) tracked_struct_level = broken_fractal;
                    }
                }
            }
            
            // 2b. FIX: While already armed, keep updating tracked_struct_level to the
            //     most recently broken fractal. This handles the case where price
            //     continues breaking new fractals after the initial BOS arm — each
            //     new break moves the retest level to the latest broken structure.
            if(bos_armed && Use_BOS_Exit) {
                if(pos_type == POSITION_TYPE_BUY) {
                    double new_level = FindMostRecentBrokenFractalLow(entry_bar);
                    // Only update if the new fractal is below our current level
                    // (price is breaking further down — track the latest broken fractal)
                    if(new_level > 0 && new_level < tracked_struct_level)
                        tracked_struct_level = new_level;
                }
                else if(pos_type == POSITION_TYPE_SELL) {
                    double new_level = FindMostRecentBrokenFractalHigh(entry_bar);
                    // Only update if the new fractal is above our current level
                    // (price is breaking further up — track the latest broken fractal)
                    if(new_level > 0 && new_level > tracked_struct_level)
                        tracked_struct_level = new_level;
                }
            }

            // 3. STEP 1: CALCULATE TRUE STRUCTURAL MOMENTUM
            d_pure_momentum = true;
            d_mom_status = "HOLDING (Strong/Valid)";
            
            if(Use_Momentum_Hold && (!Require_Spike_Entry || trade_is_spike)) {
                if(entry_bar <= 0) { 
                    d_pure_momentum = true;
                    d_mom_status = "HOLDING (Entry Bar Forming)";
                } else {
                    for(int j = entry_bar - 1; j >= 1; j--) {
                        int prev_bar = j + 1; 
                        
                        double p_high = iHigh(_Symbol, _Period, prev_bar);
                        double p_low = iLow(_Symbol, _Period, prev_bar);

                        double c_open = iOpen(_Symbol, _Period, j);
                        double c_close = iClose(_Symbol, _Period, j); 

                        double c_body_top = MathMax(c_open, c_close);
                        double c_body_bot = MathMin(c_open, c_close);
                        
                        bool full_engulf = (c_body_top >= p_high && c_body_bot <= p_low && (p_high - p_low) > 0);

                        if(pos_type == POSITION_TYPE_BUY) {
                            bool is_bearish = (c_close < c_open);
                            if(is_bearish) {
                                if(c_close < p_low) { 
                                    d_pure_momentum = false; 
                                    d_mom_status = "BROKEN: Cdl " + IntegerToString(j) + " Close < Prev Low"; 
                                    break; 
                                }
                                if(full_engulf) { 
                                    d_pure_momentum = false; 
                                    d_mom_status = "BROKEN: Cdl " + IntegerToString(j) + " Bearish Engulf (Full)"; 
                                    break; 
                                }
                            }
                        } else if(pos_type == POSITION_TYPE_SELL) {
                            bool is_bullish = (c_close > c_open);
                            if(is_bullish) {
                                if(c_close > p_high) { 
                                    d_pure_momentum = false; 
                                    d_mom_status = "BROKEN: Cdl " + IntegerToString(j) + " Close > Prev High"; 
                                    break; 
                                }
                                if(full_engulf) { 
                                    d_pure_momentum = false; 
                                    d_mom_status = "BROKEN: Cdl " + IntegerToString(j) + " Bullish Engulf (Full)"; 
                                    break; 
                                }
                            }
                        }
                    }
                }
            } else {
                d_pure_momentum = false; 
                if(!Use_Momentum_Hold) d_mom_status = "DISABLED (In Settings)";
                else d_mom_status = "DISABLED (No Entry Spike)";
            }

            // 4. EXIT HIERARCHY
            bool close_trade = false;

            // --- RISK MANAGEMENT OVERRIDE (Stop Losses) ---
            // These evaluate unconditionally before any Momentum Hold logic.
            // If we are in a losing trade, we must exit if stop-loss structures are broken.
            
            // 1. BOS Risk Manager & Slow Crawl Exit
            if(!close_trade && bos_armed && Use_BOS_Exit) {
                double tolerance = atr_m1[0] * BOS_Retest_ATR;
                
                // Retest Exit
                if(pos_type == POSITION_TYPE_SELL && (Wait_For_BOS_Retest ? (current_price <= (tracked_struct_level + tolerance)) : true)) close_trade = true;
                if(pos_type == POSITION_TYPE_BUY  && (Wait_For_BOS_Retest ? (current_price >= (tracked_struct_level - tolerance)) : true)) close_trade = true;
                
                // Slow Crawl Exit
                if(!close_trade && Use_Crawl_Exit) {
                    bool is_crawling = true;
                    double crawl_dist = atr_m1[0] * Crawl_Distance_ATR;

                    if(pos_type == POSITION_TYPE_SELL) {
                        if(current_price < (tracked_struct_level + crawl_dist)) is_crawling = false; 
                        else {
                            for(int c=1; c<=Crawl_Consecutive_Bars; c++) {
                                if(crawl_ma[c] <= crawl_ma[c+1]) { is_crawling = false; break; }
                            }
                        }
                    } else {
                        if(current_price > (tracked_struct_level - crawl_dist)) is_crawling = false; 
                        else {
                            for(int c=1; c<=Crawl_Consecutive_Bars; c++) {
                                if(crawl_ma[c] >= crawl_ma[c+1]) { is_crawling = false; break; }
                            }
                        }
                    }
                    if(is_crawling) close_trade = true;
                }
            }

            // 2. Mean Touch Loss Exit
            // If price revisits the M1 BB mean while the trade is underwater, exit immediately.
            // This caps losses on reversal trades that failed to push through.
            if(!close_trade && Use_Mean_Loss_Exit) {
                bool is_at_loss = (pos_type == POSITION_TYPE_BUY)  ? (current_price < open_price)
                                : (pos_type == POSITION_TYPE_SELL) ? (current_price > open_price)
                                : false;
                if(is_at_loss) {
                    if(pos_type == POSITION_TYPE_BUY  && current_price >= bb_base_m1[0]) close_trade = true;
                    if(pos_type == POSITION_TYPE_SELL && current_price <= bb_base_m1[0]) close_trade = true;
                }
            }

            // --- PROFIT TARGETS & TREND HOLDS ---
            // A. Ultimate Momentum Target: Opposite Band Tolerance
            bool hit_opposite_target = false;
            double band_width = bb_up_m1[0] - bb_dn_m1[0];
            
            // Bypass the M1 opposite band exit if this is an upgraded HTF trade
            if(!active_trade_is_upgraded) {
                if(pos_type == POSITION_TYPE_BUY  && current_price >= (bb_up_m1[0] - (band_width * Opposite_Band_Tolerance))) hit_opposite_target = true;
                if(pos_type == POSITION_TYPE_SELL && current_price <= (bb_dn_m1[0] + (band_width * Opposite_Band_Tolerance))) hit_opposite_target = true;
            }

            bool had_fast_push = false;
            if(Use_Momentum_Hold && d_pure_momentum) {
                int limit = MathMin(entry_bar + 1, Opposite_Band_Fast_Push_Bars);
                for(int b = entry_bar; b >= entry_bar - limit + 1; b--) {
                    double bb_u[1], bb_d[1];
                    if(CopyBuffer(handle_BB_M1, 1, b, 1, bb_u) > 0 && CopyBuffer(handle_BB_M1, 2, b, 1, bb_d) > 0) {
                        double b_width = bb_u[0] - bb_d[0];
                        if(pos_type == POSITION_TYPE_BUY  && iHigh(_Symbol, _Period, b) >= (bb_u[0] - (b_width * Opposite_Band_Tolerance))) { had_fast_push = true; break; }
                        if(pos_type == POSITION_TYPE_SELL && iLow(_Symbol, _Period, b) <= (bb_d[0] + (b_width * Opposite_Band_Tolerance))) { had_fast_push = true; break; }
                    }
                }
            }

            if(!close_trade && hit_opposite_target) {
                bool block_exit_fast_push = false;
                if(had_fast_push) {
                    block_exit_fast_push = true;
                    d_mom_status = "HOLDING (Fast Push to Band)";
                }
                if(!block_exit_fast_push) close_trade = true;
            }

            // H1 Mean Exit for Fast Push hold
            if(!close_trade && had_fast_push && Fast_Push_H1_Mean_Exit) {
                if(pos_type == POSITION_TYPE_BUY  && current_price >= bb_base_h1[0]) close_trade = true;
                if(pos_type == POSITION_TYPE_SELL && current_price <= bb_base_h1[0]) close_trade = true;
            }

            // --- MOMENTUM HOLD: MEAN PULLBACK PROTECTION ---
            // When price reaches the M1 BB mean during a momentum hold trade:
            //   1. Close MH_MeanPullback_ReducePct (default 30%) of the position.
            //   2. Move SL to breakeven + MH_MeanPullback_SL_ATR * ATR.
            // Fires only once per trade. Target remains unchanged.
            if(!close_trade && Use_MH_Mean_Pullback && Use_Momentum_Hold && d_pure_momentum && !mh_mean_pullback_done) {
                // Trigger when price has covered MH_MeanPullback_Trigger_Pct of the entry-band-to-mean distance
                // BUY  entered near lower band: fire when price >= lower_band + pct*(mean - lower_band)
                // SELL entered near upper band: fire when price <= upper_band - pct*(upper_band - mean)
                double half_band    = (bb_up_m1[0] - bb_dn_m1[0]) * 0.5; // = mean-to-band distance
                double trigger_pct  = MH_MeanPullback_Trigger_Pct;
                bool near_mean = false;
                if(pos_type == POSITION_TYPE_BUY  && current_price >= (bb_dn_m1[0] + half_band * trigger_pct)) near_mean = true;
                if(pos_type == POSITION_TYPE_SELL && current_price <= (bb_up_m1[0] - half_band * trigger_pct)) near_mean = true;
                
                if(near_mean) {
                    mh_mean_pullback_done = true; // Guard — only fires once
                    
                    double cur_lots = PositionGetDouble(POSITION_VOLUME);
                    double close_lots = NormalizeDouble(cur_lots * MH_MeanPullback_ReducePct, 2);
                    
                    // Clamp to broker min/max
                    double min_lot = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_MIN);
                    double lot_step = SymbolInfoDouble(_Symbol, SYMBOL_VOLUME_STEP);
                    close_lots = MathFloor(close_lots / lot_step) * lot_step;
                    if(close_lots < min_lot) close_lots = min_lot;
                    if(close_lots >= cur_lots) close_lots = cur_lots; // Safety: don't close more than we have
                    
                    // Partial close
                    if(close_lots >= min_lot && close_lots < cur_lots) {
                        ClosePositionAggressive(ticket, close_lots);
                    }
                    
                    // Move SL to breakeven + ATR buffer in our favour (locks in a small profit)
                    // BUY:  SL = entry + buffer  (above entry → profit locked)
                    // SELL: SL = entry - buffer  (below entry → profit locked)
                    double sl_buffer = atr_m1[0] * MH_MeanPullback_SL_ATR;
                    double new_sl;
                    if(pos_type == POSITION_TYPE_BUY) {
                        new_sl = NormalizeDouble(open_price + sl_buffer, _Digits);
                        // Only move SL if it's actually an improvement (higher than current SL)
                        double cur_sl = PositionGetDouble(POSITION_SL);
                        if(new_sl > cur_sl) trade.PositionModify(ticket, new_sl, PositionGetDouble(POSITION_TP));
                    } else {
                        new_sl = NormalizeDouble(open_price - sl_buffer, _Digits);
                        // Only move SL if it's actually an improvement (lower than current SL)
                        double cur_sl = PositionGetDouble(POSITION_SL);
                        if(cur_sl == 0 || new_sl < cur_sl) trade.PositionModify(ticket, new_sl, PositionGetDouble(POSITION_TP));
                    }
                    
                    d_mom_status = StringFormat("HOLDING (MeanPullback: %.0f%% closed, SL locked)", MH_MeanPullback_ReducePct * 100.0);
                }
            }

            // B. If Pure Momentum is FALSE, we execute standard profit targets
            if(!close_trade && (!Use_Momentum_Hold || !d_pure_momentum)) {
                
                // 1. Standard TP
                CalculateDynamicTP(open_price, pos_type == POSITION_TYPE_BUY);
                if(pos_type == POSITION_TYPE_BUY && current_price >= dynamic_virtual_tp) close_trade = true;
                if(pos_type == POSITION_TYPE_SELL && current_price <= dynamic_virtual_tp) close_trade = true;
            }

            // 5. Execution
            if(close_trade) {
                ClosePositionAggressive(ticket);
                continue;
            }
        }
    }
}

void InitDynamicTP(double open_price, bool isBuy) { 
    dynamic_virtual_tp = isBuy ? 999999.0 : 0.000001; 
    locked_htf_virtual_tp = 0.0; // Reset for new trade
    
    active_trade_is_upgraded = false;
    if(Use_HTF_TP_Upgrade) {
        if(isBuy && d_rsi_h1_value >= RSI_Strong_Up) active_trade_is_upgraded = true;
        if(!isBuy && d_rsi_h1_value <= RSI_Strong_Dn) active_trade_is_upgraded = true;
    }
    
    CalculateDynamicTP(open_price, isBuy); 
    
    // Once the initial dynamic TP is calculated for the HTF target, lock it down
    // and apply a 1 ATR deviation to make it reachable.
    if(active_trade_is_upgraded && HTF_TP_Execution_Mode == HTF_TP_STATIC) {
        double atr_val = (ArraySize(atr_m1) > 0) ? atr_m1[0] : 0.0;
        if(isBuy) {
            locked_htf_virtual_tp = dynamic_virtual_tp - atr_val;
            if(locked_htf_virtual_tp < bb_base_m1[0]) locked_htf_virtual_tp = bb_base_m1[0]; // floor limit
        } else {
            locked_htf_virtual_tp = dynamic_virtual_tp + atr_val;
            if(locked_htf_virtual_tp > bb_base_m1[0]) locked_htf_virtual_tp = bb_base_m1[0]; // ceil limit
        }
        dynamic_virtual_tp = locked_htf_virtual_tp;
    }
}

void CalculateDynamicTP(double open_price, bool isBuy) {
    // Standard Target
    double target_price = TP_Type == TP_HALF_MEAN ? open_price + ((bb_base_m1[0] - open_price) / 2.0) : bb_base_m1[0];
    
    if(active_trade_is_upgraded) {
        if(HTF_TP_Execution_Mode == HTF_TP_STATIC && locked_htf_virtual_tp > 0.0) {
            dynamic_virtual_tp = locked_htf_virtual_tp;
            return;
        }

        double band_range = 0.0;

        if(HTF_Upgrade_Target == TARGET_M5_MEAN) {
            target_price = bb_base_m5[0];
            band_range = bb_up_m5[0] - bb_base_m5[0];
        } else if(HTF_Upgrade_Target == TARGET_M5_OPP_BAND) {
            target_price = isBuy ? bb_up_m5[0] : bb_dn_m5[0];
            band_range = bb_up_m5[0] - bb_base_m5[0];
        } else if(HTF_Upgrade_Target == TARGET_H1_MEAN) {
            target_price = bb_base_h1[0];
            band_range = bb_up_h1[0] - bb_base_h1[0];
        } else if(HTF_Upgrade_Target == TARGET_H1_OPP_BAND) {
            target_price = isBuy ? bb_up_h1[0] : bb_dn_h1[0];
            band_range = bb_up_h1[0] - bb_base_h1[0];
        }
        
        // Apply Range Offset if enabled
        if(HTF_TP_Execution_Mode == HTF_TP_RANGE_PCT && band_range > 0.0) {
            double offset  = band_range * (HTF_TP_Range_Pct / 100.0);
            if(isBuy) target_price -= offset;
            else      target_price += offset;
        }
        
        // Ensure the upgrade target is actually better than the standard M1 target
        if(isBuy && target_price < bb_base_m1[0]) target_price = bb_base_m1[0];
        if(!isBuy && target_price > bb_base_m1[0]) target_price = bb_base_m1[0];
        
        // Curve smoothly with the HTF band
        dynamic_virtual_tp = target_price;
        return;
    }

    if(isBuy) { if(target_price < dynamic_virtual_tp) dynamic_virtual_tp = target_price; } 
    else      { if(target_price > dynamic_virtual_tp) dynamic_virtual_tp = target_price; }
}

//+------------------------------------------------------------------+
//| High Impact News Checking Functions                              |
//+------------------------------------------------------------------+
bool CheckNewsForCurrency(string currency, datetime from_time, datetime to_time) {
    MqlCalendarValue values[];
    if(CalendarValueHistory(values, from_time, to_time, NULL, currency)) {
        for(int i = 0; i < ArraySize(values); i++) {
            MqlCalendarEvent event;
            if(CalendarEventById(values[i].event_id, event)) {
                if(event.importance == CALENDAR_IMPORTANCE_HIGH) {
                    return true;
                }
            }
        }
    }
    return false;
}

bool IsNewsTime() {
    if(!Use_News_Filter) return false;
    
    datetime current_time = TimeCurrent();
    
    // Only check the API once per minute to prevent terminal lag
    if(current_time - last_news_check_time < 60) {
        return cached_news_state;
    }
    
    last_news_check_time = current_time;
    datetime from_time = current_time - (MinsAfterNews * 60);
    datetime to_time = current_time + (MinsBeforeNews * 60);
    
    string base_currency = SymbolInfoString(_Symbol, SYMBOL_CURRENCY_BASE);
    string profit_currency = SymbolInfoString(_Symbol, SYMBOL_CURRENCY_PROFIT);
    
    cached_news_state = (CheckNewsForCurrency(base_currency, from_time, to_time) || CheckNewsForCurrency(profit_currency, from_time, to_time));
    
    return cached_news_state;
}