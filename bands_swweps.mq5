// -----------------------------------------------------------------------
// NEW: RSI-Adaptive H1 Zone
// -----------------------------------------------------------------------
// When H1 RSI shows WEAK momentum toward the relevant band, the allowed
// entry zone is widened so the EA can enter further from the extreme.
// Maximum expansion is capped at 25% of the H1 band range, which equals
// the midpoint between the Bollinger mean and the band edge.
//
//   Sell zone (near upper band):
//     RSI >= RSI_Strong_Up  (e.g. 70) → tight zone  = H1_Extreme_Zone_Pct
//     RSI <= RSI_Weak_Level (e.g. 50) → wide zone   = H1_RSI_Max_Zone_Pct
//     Between              → linear interpolation
//
//   Buy zone (near lower band):
//     RSI <= RSI_Strong_Dn  (e.g. 30) → tight zone  = H1_Extreme_Zone_Pct
//     RSI >= RSI_Weak_Level (e.g. 50) → wide zone   = H1_RSI_Max_Zone_Pct
//     Between              → linear interpolation
// -----------------------------------------------------------------------
input string               __RSI_Zone__ = "=== 4b. H1 RSI-Adaptive Zone ===";
input bool                 Use_RSI_Zone_Adapt = true;     // [TOGGLE] Expand H1 zone when RSI momentum is weak
input int                  RSI_H1_Period = 14;            // RSI period on H1 timeframe
input double               RSI_Strong_Up = 70.0;          // RSI >= this → strong upward momentum (tight SELL zone)
input double               RSI_Strong_Dn = 30.0;          // RSI <= this → strong downward momentum (tight BUY zone)
input double               RSI_Weak_Level = 50.0;         // RSI at this level → weakest momentum (widest zone)
input double               H1_RSI_Max_Zone_Pct = 0.25;   // Max allowed zone pct (= midpoint between mean & band). Hard cap.

input string               __Squeeze__ = "=== 5. Volatility Squeeze Filter ===";
input bool                 Use_Squeeze_Filter = true;              // [TOGGLE] Adapt extremes during low volatility

enum ENUM_SQUEEZE_METHOD {
    SQZ_ATR = 0,         // ATR Method (Wait until Width < ATR × Multiplier)
    SQZ_RELATIVE = 1,    // Relative Avg Method (Wait until Width < X% of past average)
    SQZ_BOTH = 2         // Both Methods (Squeeze if EITHER condition is met)
};

